<section
  class="section brand-logos brand-logos--{{ section.settings.layout }} color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header{% if section.settings.layout == 'marquee' %} section-header--center{% endif %}">
        <div class="section-header__text"><h2 class="{% if section.settings.layout == 'marquee' %}h2{% else %}h3{% endif %}">{{ section.settings.heading }}</h2></div>
      </div>
    {%- endif -%}
    {%- if section.settings.layout == 'marquee' -%}<div class="brand-logos__viewport"><div class="brand-logos__track">{%- endif -%}
    {%- for copy in (1..2) -%}
    {%- if copy == 2 and section.settings.layout != 'marquee' -%}{%- break -%}{%- endif -%}
    <ul class="brand-logos__list" role="list"{% if copy == 2 %} aria-hidden="true"{% endif %}>
      {%- for block in section.blocks -%}
        {%- assign brand_url = block.settings.name | url_for_vendor -%}
        <li {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
          <a href="{{ block.settings.link | default: brand_url }}"{% if copy == 2 %} tabindex="-1"{% endif %} class="brand-logos__item{% if block.settings.logo == blank %} brand-logos__item--text{% endif %}" aria-label="{{ block.settings.name | escape }}">
            {%- if block.settings.logo != blank -%}
              {{ block.settings.logo | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              <span class="brand-logos__name">{{ block.settings.name }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- endfor -%}
    {%- if section.settings.layout == 'marquee' -%}</div></div>{%- endif -%}
  </div>
</section>

{% stylesheet %}
  .brand-logos__list {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(2, auto);
    grid-auto-columns: 34%;
    gap: 0.5rem;
    margin: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }

  @media screen and (min-width: 750px) {
    .brand-logos__list {
      grid-auto-flow: row;
      grid-template-rows: none;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      overflow: visible;
      gap: 1rem;
    }
  }

  .brand-logos__item {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    color: var(--color-fg);
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .brand-logos__item:hover {
    transform: translateY(-3px);
  }

  .brand-logos__list li {
    display: contents;
  }

  .brand-logos__item img {
    width: 100%;
    max-width: 9rem;
    height: 100%;
    max-height: 3rem;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .brand-logos__name {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-stretch: var(--heading-stretch);
    text-transform: uppercase;
    font-size: clamp(0.9375rem, 1.6vw, 1.25rem);
    letter-spacing: -0.02em;
    text-align: center;
    line-height: 1.1;
  }

  /* Text-only tiles invert on hover; logo tiles just lift, so dark logos stay visible. */
  .brand-logos__item--text:hover {
    background: var(--color-fg);
    color: var(--color-bg);
  }

  .brand-logos--marquee {
    overflow: hidden;
  }

  .brand-logos__viewport {
    margin-inline: calc(var(--page-gutter, 1rem) * -1);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .brand-logos__track {
    display: flex;
    width: max-content;
    animation: brand-logos-scroll 45s linear infinite;
  }

  [dir='rtl'] .brand-logos__track {
    animation-name: brand-logos-scroll-rtl;
  }

  .brand-logos__viewport:hover .brand-logos__track {
    animation-play-state: paused;
  }

  .brand-logos--marquee .brand-logos__list {
    display: flex;
    gap: 1rem;
    padding-inline-end: 1rem;
    padding-block: 0.5rem;
    overflow: visible;
  }

  .brand-logos--marquee .brand-logos__item {
    width: 11rem;
    filter: grayscale(1);
    opacity: 0.75;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
  }

  .brand-logos--marquee .brand-logos__item:hover {
    filter: none;
    opacity: 1;
    transform: translateY(-4px) scale(1.04);
  }

  @keyframes brand-logos-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes brand-logos-scroll-rtl {
    to {
      transform: translateX(50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-logos__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.brand_logos.name",
  "max_blocks": 18,
  "settings": [
    { "type": "text", "id": "heading", "default": "Shop by brand", "label": "t:settings.heading" },
    {
      "type": "select",
      "id": "layout",
      "default": "grid",
      "label": "t:settings.layout",
      "options": [
        { "value": "grid", "label": "t:pages.brands.layout_grid" },
        { "value": "marquee", "label": "t:pages.brands.layout_marquee" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.brand_logos.blocks.brand.name",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "t:sections.brand_logos.blocks.brand.settings.logo.label" },
        { "type": "text", "id": "name", "default": "Brand", "label": "t:sections.brand_logos.blocks.brand.settings.name.label" },
        { "type": "url", "id": "link", "label": "t:settings.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.brand_logos.name",
      "blocks": [{ "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }, { "type": "brand" }]
    }
  ]
}
{% endschema %}
