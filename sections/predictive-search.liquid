{%- comment -%} Rendered through the Section Rendering API by <predictive-search>. {%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- liquid
    assign products = predictive_search.resources.products
    assign collections = predictive_search.resources.collections
    assign queries = predictive_search.resources.queries
  -%}
  <div class="predictive" id="predictive-search-results">
    {%- if queries.size > 0 or collections.size > 0 -%}
      <ul class="predictive__chips" role="list">
        {%- for query in queries -%}
          <li><a class="predictive__chip" href="{{ query.url }}">{{ query.styled_text }}</a></li>
        {%- endfor -%}
        {%- for collection in collections -%}
          <li><a class="predictive__chip predictive__chip--collection" href="{{ collection.url }}">{{ collection.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <p class="eyebrow predictive__label">{{ 'general.search.products' | t }}</p>
      <ul class="predictive__products" role="listbox">
        {%- for product in products limit: 6 -%}
          <li role="option">
            <a href="{{ product.url }}" class="predictive__product">
              <div class="media media--square predictive__image">
                {%- if product.featured_media -%}
                  {{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title }}
                {%- endif -%}
              </div>
              <div>
                <p class="predictive__title">{{ product.title }}</p>
                {% render 'price', product: product %}
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if products.size == 0 and collections.size == 0 and queries.size == 0 -%}
      <p class="predictive__empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- else -%}
      <a href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&options%5Bprefix%5D=last" class="link-arrow predictive__all">
        {{- 'general.search.view_all' | t: terms: predictive_search.terms -}}
        {% render 'icon', icon: 'arrow' %}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive {
    display: grid;
    gap: 0.75rem;
    padding: 0.5rem;
  }

  .predictive__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
  }

  .predictive__chip {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.875rem;
    text-decoration: none;
  }

  .predictive__chip mark {
    background: none;
    font-weight: 700;
    color: inherit;
  }

  .predictive__chip--collection {
    border: 1px solid var(--color-border);
    background: transparent;
  }

  .predictive__products {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive__product {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.875rem;
    align-items: center;
    padding: 0.5rem;
    border-radius: var(--radius-small);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .predictive__product:hover,
  .predictive__product:focus {
    background: var(--color-surface);
  }

  .predictive__image {
    border-radius: var(--radius-small);
  }

  .predictive__title {
    font-weight: 500;
    line-height: 1.3;
  }

  .predictive__empty {
    padding: 1rem;
    color: var(--color-muted);
  }

  .predictive__all {
    padding: 0.5rem;
  }
{% endstylesheet %}
