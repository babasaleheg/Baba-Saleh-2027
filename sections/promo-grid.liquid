<section
  class="section promo-grid color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <div class="promo-grid__grid promo-grid__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          assign tile_image = block.settings.image | default: tile_collection.featured_image
          assign tile_url = block.settings.link | default: tile_collection.url | default: routes.collections_url
        -%}
        <a
          href="{{ tile_url }}"
          class="promo-tile color-{{ block.settings.color_scheme }}"
          data-reveal
          style="--reveal-index: {{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="promo-tile__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 50vw, 100vw',
                  widths: '400, 600, 900, 1200, 1500, 1800'
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="promo-tile__content">
            {%- if block.settings.eyebrow != blank -%}
              <span class="badge badge--accent">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="h2 promo-tile__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="promo-tile__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="link-arrow">{{ block.settings.button_label }}{% render 'icon', icon: 'arrow' %}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .promo-grid__grid {
    display: grid;
    gap: 0.75rem;
  }

  @media screen and (min-width: 750px) {
    .promo-grid__grid {
      gap: 1.25rem;
    }

    .promo-grid__grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .promo-grid__grid--3 {
      grid-template-columns: 1.4fr 1fr;
      grid-template-rows: repeat(2, minmax(15rem, auto));
    }

    .promo-grid__grid--3 .promo-tile {
      min-height: 0;
    }

    .promo-grid__grid--3 > :first-child {
      grid-row: span 2;
    }

    .promo-grid__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .promo-tile {
    position: relative;
    display: grid;
    min-height: 22rem;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: #fff;
    text-decoration: none;
    isolation: isolate;
  }

  .promo-tile__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .promo-tile__media img,
  .promo-tile__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .promo-tile:hover .promo-tile__media img {
    transform: scale(1.05);
  }

  .promo-tile__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0) 60%);
  }

  .promo-tile__content {
    align-self: end;
    display: grid;
    justify-items: start;
    gap: 0.625rem;
    padding: 1.5rem;
  }

  .promo-tile__heading {
    color: #fff;
  }

  .promo-tile__text {
    opacity: 0.88;
    max-width: 32rem;
  }

  .promo-tile .link-arrow .icon {
    transition: transform 0.25s ease;
  }

  .promo-tile:hover .link-arrow .icon {
    transform: translateX(4px);
  }

  [dir='rtl'] .promo-tile:hover .link-arrow .icon {
    transform: scaleX(-1) translateX(4px);
  }

  @media screen and (min-width: 990px) {
    .promo-tile {
      min-height: 24rem;
    }

    .promo-grid__grid--3 {
      grid-template-rows: repeat(2, minmax(17rem, auto));
    }

    .promo-tile__content {
      padding: 2.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.promo_grid.name",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 24, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "t:sections.promo_grid.blocks.tile.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:settings.image" },
        { "type": "collection", "id": "collection", "label": "t:settings.collection", "info": "t:sections.promo_grid.blocks.tile.settings.collection.info" },
        { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
        { "type": "text", "id": "heading", "default": "Gym essentials", "label": "t:settings.heading" },
        { "type": "text", "id": "text", "label": "t:settings.text" },
        { "type": "text", "id": "button_label", "default": "Shop now", "label": "t:settings.button_label" },
        { "type": "url", "id": "link", "label": "t:settings.link" },
        { "type": "color_scheme", "id": "color_scheme", "default": "scheme-3", "label": "t:settings.color_scheme" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.promo_grid.name",
      "blocks": [{ "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
