{%- paginate search.results by 24 -%}
  <facet-filters class="section search color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" style="--section-pt: 2rem; --section-pb: 4rem;">
    <div class="page-width">
      <header class="search__header">
        <h1 class="h1">{{ 'templates.search.title' | t }}</h1>
        <div class="search__form">{% render 'search-form', id_prefix: 'Main' %}</div>
      </header>

      {%- if search.performed -%}
        <div class="collection__toolbar">
          {%- if search.filters.size > 0 -%}
            <button type="button" class="button button--secondary button--small" data-drawer-open="FilterDrawer" aria-controls="FilterDrawer">
              {% render 'icon', icon: 'filter' %}
              {{ 'collections.filter.title' | t }}
            </button>
          {%- endif -%}
          <p class="collection__count text-muted" role="status">
            {{ 'templates.search.results_count' | t: count: search.results_count, terms: search.terms }}
          </p>
        </div>

        {% render 'facets-active', results: search %}

        <div class="collection__results" data-results>
          {%- if search.results_count > 0 -%}
            <ul class="product-grid" role="list" data-product-grid>
              {%- comment -%} Pass 1: in-stock products, 2: sold-out products, 3: articles and pages {%- endcomment -%}
              {%- assign card_index = 0 -%}
              {%- for pass in (1..3) -%}
              {%- for item in search.results -%}
                {%- liquid
                  assign item_pass = 3
                  if item.object_type == 'product'
                    assign item_pass = 2
                    if item.available
                      assign item_pass = 1
                    endif
                  endif
                -%}
                {%- if item_pass != pass -%}{%- continue -%}{%- endif -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {% render 'product-card', product: item, index: card_index %}
                      {%- assign card_index = card_index | plus: 1 -%}
                    {%- else -%}
                      <a href="{{ item.url }}" class="search__article">
                        {%- assign type_key = 'templates.search.types.' | append: item.object_type -%}
                        <span class="eyebrow">{{ type_key | t }}</span>
                        <span class="h4">{{ item.title }}</span>
                        <span class="text-muted">{{ item.content | strip_html | truncatewords: 20 }}</span>
                      </a>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
              {%- endfor -%}
            </ul>
            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate %}
            {%- endif -%}
          {%- else -%}
            <div class="empty-state">
              <p class="h3">{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.continue_shopping' | t }}</a>
            </div>
          {%- endif -%}
        </div>

        {%- if search.filters.size > 0 -%}
          {% render 'facets', results: search, results_url: routes.search_url, terms: search.terms %}
        {%- endif -%}
      {%- endif -%}
    </div>
  </facet-filters>
{%- endpaginate -%}

{% stylesheet %}
  .search__header {
    display: grid;
    gap: 1.5rem;
    justify-items: center;
    text-align: center;
    margin-block-end: 2rem;
  }

  .search__form {
    width: min(40rem, 100%);
  }

  .search__form .search-form__input {
    height: 3.5rem;
    font-size: 1.0625rem;
  }

  .search__article {
    display: grid;
    gap: 0.5rem;
    height: 100%;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" }
  ]
}
{% endschema %}
