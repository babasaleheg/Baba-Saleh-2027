<section class="section main-page color-{{ section.settings.color_scheme }}">
  <div class="page-width main-page__inner">
    <h1 class="h1">{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>
  </div>
</section>

{% stylesheet %}
  .main-page__inner {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" }
  ]
}
{% endschema %}
