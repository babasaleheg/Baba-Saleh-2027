{%- comment -%}
  Photo gallery: a grid of images that open full size in a lightbox.
  Add one "Photo" block per image.
{%- endcomment -%}
<section
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="section photo-gallery color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.text != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul class="photo-gallery__grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {%- assign alt = block.settings.caption | default: block.settings.image.alt | default: section.settings.heading -%}
          <li class="photo-gallery__item" data-reveal style="--reveal-index: {{ forloop.index0 | modulo: 8 }}" {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.image | image_url: width: 1800 }}"
              class="photo-gallery__link"
              data-gallery-open
              data-caption="{{ block.settings.caption | escape }}"
            >
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 900', alt: alt
              }}
              {%- if block.settings.caption != blank -%}
                <span class="photo-gallery__caption">{{ block.settings.caption }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  <dialog class="photo-gallery__dialog" aria-label="{{ section.settings.heading | default: 'Photo' | escape }}">
    <button type="button" class="photo-gallery__close" aria-label="{{ 'general.close' | t }}" data-gallery-close>
      {% render 'icon', icon: 'close' %}
    </button>
    <button type="button" class="photo-gallery__nav photo-gallery__nav--prev" aria-label="Previous" data-gallery-step="-1">
      {% render 'icon', icon: 'chevron-down' %}
    </button>
    <figure class="photo-gallery__figure">
      <img src="" alt="" data-gallery-image>
      <figcaption data-gallery-caption></figcaption>
    </figure>
    <button type="button" class="photo-gallery__nav photo-gallery__nav--next" aria-label="Next" data-gallery-step="1">
      {% render 'icon', icon: 'chevron-down' %}
    </button>
  </dialog>
</section>

<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    const dialog = root.querySelector('.photo-gallery__dialog');
    const img = dialog.querySelector('[data-gallery-image]');
    const caption = dialog.querySelector('[data-gallery-caption]');
    const links = [...root.querySelectorAll('[data-gallery-open]')];
    let index = 0;
    const show = (i) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt || '';
      caption.textContent = link.dataset.caption || '';
    };
    links.forEach((link, i) => link.addEventListener('click', (e) => {
      if (!dialog.showModal) return;
      e.preventDefault();
      show(i);
      dialog.showModal();
    }));
    dialog.addEventListener('click', (e) => {
      const step = e.target.closest('[data-gallery-step]');
      if (step) return show(index + Number(step.dataset.galleryStep));
      if (e.target.closest('[data-gallery-close]') || e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      const rtl = document.dir === 'rtl';
      if (e.key === 'ArrowRight') show(index + (rtl ? -1 : 1));
      if (e.key === 'ArrowLeft') show(index + (rtl ? 1 : -1));
    });
  })();
</script>

{% stylesheet %}
  .photo-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .photo-gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media screen and (min-width: 1100px) {
    .photo-gallery__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .photo-gallery__grid {
      grid-auto-flow: dense;
    }

    .photo-gallery__item:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .photo-gallery__link {
    position: relative;
    display: block;
    height: 100%;
    aspect-ratio: 1;
    border-radius: 1.25rem;
    overflow: hidden;
    background: var(--color-surface);
    isolation: isolate;
  }

  .photo-gallery__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .photo-gallery__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 0 #febd19;
    transition: box-shadow 0.3s ease;
  }

  .photo-gallery__link:hover img {
    transform: scale(1.06);
  }

  .photo-gallery__link:hover::after {
    box-shadow: inset 0 0 0 4px #febd19;
  }

  .photo-gallery__caption {
    position: absolute;
    inset-inline: 0.75rem;
    inset-block-end: 0.75rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.75);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    width: fit-content;
  }

  .photo-gallery__dialog {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 10, 10, 0.94);
    color: #fff;
  }

  .photo-gallery__dialog[open] {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
  }

  .photo-gallery__dialog::backdrop {
    background: transparent;
  }

  .photo-gallery__figure {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 4rem 0.5rem;
    height: 100vh;
    align-content: center;
  }

  .photo-gallery__figure img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    object-fit: contain;
    border-radius: 1rem;
  }

  .photo-gallery__figure figcaption:empty {
    display: none;
  }

  .photo-gallery__close,
  .photo-gallery__nav {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .photo-gallery__close:hover,
  .photo-gallery__nav:hover {
    background: #febd19;
    color: #0a0a0a;
  }

  .photo-gallery__close {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    z-index: 1;
  }

  .photo-gallery__nav {
    margin-inline: 0.75rem;
  }

  .photo-gallery__nav--prev .icon {
    transform: rotate(90deg);
  }

  .photo-gallery__nav--next .icon {
    transform: rotate(-90deg);
  }

  [dir='rtl'] .photo-gallery__nav--prev .icon {
    transform: rotate(-90deg);
  }

  [dir='rtl'] .photo-gallery__nav--next .icon {
    transform: rotate(90deg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Photo gallery",
  "max_blocks": 40,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
    { "type": "text", "id": "heading", "default": "Gallery", "label": "t:settings.heading" },
    { "type": "richtext", "id": "text", "label": "t:settings.text" },
    { "type": "text", "id": "anchor", "label": "Anchor (for links like #gallery)" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:settings.image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "Photo gallery", "blocks": [{ "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }] }]
}
{% endschema %}
