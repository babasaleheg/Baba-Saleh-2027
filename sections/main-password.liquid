<section class="section main-password color-{{ section.settings.color_scheme }}">
  <div class="page-width main-password__inner">
    <p class="h0">{{ shop.name }}</p>
    {%- if shop.password_message != blank -%}
      <p class="h3">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'main-password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <label for="PasswordNewsletter" class="visually-hidden">{{ 'sections.newsletter.placeholder' | t }}</label>
      <input id="PasswordNewsletter" class="field__input" type="email" name="contact[email]" required placeholder="{{ 'sections.newsletter.placeholder' | t }}">
      <button type="submit" class="button button--accent">{{ 'templates.password.notify' | t }}</button>
      {%- if form.posted_successfully? -%}<p class="form-message">{{ 'sections.newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}

    <details class="main-password__login">
      <summary>{{ 'templates.password.enter_using_password' | t }}</summary>
      {%- form 'storefront_password', class: 'main-password__form' -%}
        <label for="Password" class="visually-hidden">{{ 'templates.password.password' | t }}</label>
        <input id="Password" class="field__input" type="password" name="password" autocomplete="current-password" placeholder="{{ 'templates.password.password' | t }}" required>
        <button type="submit" class="button">{{ 'templates.password.enter' | t }}</button>
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% stylesheet %}
  .main-password {
    min-height: 100vh;
    display: grid;
    align-items: center;
  }

  .main-password__inner {
    display: grid;
    gap: 2rem;
    justify-items: center;
    text-align: center;
    max-width: 40rem;
  }

  .main-password__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }

  .main-password__form .field__input {
    flex: 1 1 14rem;
  }

  .main-password__login summary {
    cursor: pointer;
    text-decoration: underline;
    margin-block-end: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-3", "label": "t:settings.color_scheme" }
  ]
}
{% endschema %}
