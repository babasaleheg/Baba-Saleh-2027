    .size-finder__privacy {
      padding-block: 0.5rem;
      font-size: 0.6875rem;
    }

    .size-finder__back,
    .size-finder__next {
      height: 3rem;
    }

    .size-finder__actions {
      grid-template-columns: 3rem 1fr;
    }
  }

  /* very short screens (iPhone SE): the product name is already on the page behind */
  @media screen and (max-height: 720px) {
    .size-finder__product {
      display: none;
    }
  }

  .size-finder__actions.is-first {
    grid-template-columns: 1fr;
  }

  .size-finder__actions.is-first .size-finder__back {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .size-finder[open],
    .size-finder__step,
    .size-finder__track i {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}

