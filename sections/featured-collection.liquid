{%- liquid
  assign tab_count = section.blocks.size
  assign limit = section.settings.products_to_show
-%}
<section
  class="section featured-collection color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <product-tabs class="page-width" data-section-id="{{ section.id }}">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      <div class="slider-controls">
        <button type="button" class="icon-button icon-button--bordered" data-slider-prev aria-label="{{ 'general.slider.previous' | t }}">
          <span class="icon-flip">{% render 'icon', icon: 'arrow' %}</span>
        </button>
        <button type="button" class="icon-button icon-button--bordered" data-slider-next aria-label="{{ 'general.slider.next' | t }}">
          {% render 'icon', icon: 'arrow' %}
        </button>
      </div>
    </div>

    {%- if tab_count > 1 -%}
      <div class="tabs" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="tabs__tab"
            role="tab"
            id="Tab-{{ block.id }}"
            aria-controls="TabPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label | default: block.settings.collection.title -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign collection = block.settings.collection -%}
      <div
        class="featured-collection__panel"
        id="TabPanel-{{ block.id }}"
        {% if tab_count > 1 %}
          role="tabpanel" aria-labelledby="Tab-{{ block.id }}"
        {% endif %}
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        <ul
          class="slider"
          role="list"
          data-slider
          style="--slides-desktop: 6; --slides-tablet: 3; --slide-mobile: 46%;"
        >
          {%- if collection != blank and collection.products_count > 0 -%}
            {%- if forloop.first -%}
{%- comment -%} In stock first, sold out last (fills up to the limit). With "one product per model", colours
  sold as separate products show once: the model is the item code (first variant's SKU digits). {%- endcomment -%}
              {%- assign shown = 0 -%}
              {%- assign models_shown = '|' -%}
              {%- assign pinned_ids = '|' -%}
              {%- for product in section.settings.pinned -%}
                {%- assign pinned_ids = pinned_ids | append: product.id | append: '|' -%}
              {%- endfor -%}
              {%- for pass in (1..2) -%}
                {%- comment -%} "Show these first" products lead each pass (in stock first, sold out with the sold out) {%- endcomment -%}
                {%- for step in (1..2) -%}
                {%- if step == 1 -%}{%- assign list = section.settings.pinned -%}{%- else -%}{%- assign list = collection.products -%}{%- endif -%}
                {%- for product in list limit: 50 -%}
                  {%- if shown >= limit -%}{%- break -%}{%- endif -%}
                  {%- assign card_pass = 2 -%}{%- if product.available -%}{%- assign card_pass = 1 -%}{%- endif -%}
                  {%- if card_pass != pass -%}{%- continue -%}{%- endif -%}
                  {%- assign pin_key = '|' | append: product.id | append: '|' -%}
                  {%- if step == 2 and pinned_ids contains pin_key -%}{%- continue -%}{%- endif -%}
                  {%- if section.settings.one_per_model and step == 2 -%}
                    {%- assign model = product.variants.first.sku | remove: '#' | remove: '/' | strip | slice: 0, 6 -%}
                    {%- if model != blank -%}
                      {%- assign model_key = '|' | append: model | append: '|' -%}
                      {%- if models_shown contains model_key -%}{%- continue -%}{%- endif -%}
                      {%- assign models_shown = models_shown | append: model | append: '|' -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if step == 1 -%}
                    {%- assign model = product.variants.first.sku | remove: '#' | remove: '/' | strip | slice: 0, 6 -%}
                    {%- if model != blank -%}{%- assign models_shown = models_shown | append: model | append: '|' -%}{%- endif -%}
                  {%- endif -%}
                  <li>{% render 'product-card', product: product, index: shown %}</li>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endfor -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} Hidden tabs load when opened (collection.cards view), keeping the page light {%- endcomment -%}
              <li data-lazy-cards="{{ collection.url }}?view=cards&limit={{ limit }}">{% render 'product-card', product: blank %}</li>
            {%- endif -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li>{% render 'product-card', product: blank %}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- if section.settings.show_view_all and collection != blank -%}
          <div class="featured-collection__footer">
            <a href="{{ collection.url }}" class="button button--secondary">
              {{- 'general.view_all_in' | t: title: collection.title -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </product-tabs>
</section>

{% stylesheet %}
  .featured-collection .slider {
    --slide-gap: 0.75rem;
  }

  .featured-collection__footer {
    display: flex;
    justify-content: center;
    margin-block-start: 2rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
    { "type": "text", "id": "heading", "default": "Trending now", "label": "t:settings.heading" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 24, "step": 1, "default": 12, "label": "t:sections.featured_collection.settings.products_to_show.label" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "default": 4, "label": "t:settings.columns_desktop" },
    { "type": "checkbox", "id": "show_view_all", "default": true, "label": "t:settings.show_view_all" },
    { "type": "product_list", "id": "pinned", "limit": 12, "label": "Show these first", "info": "Shown at the start of the first tab while in stock (sold out ones move to the end)." },
    { "type": "checkbox", "id": "one_per_model", "default": false, "label": "One product per model", "info": "Colours sold as separate products of the same model (same item code) show once." },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.featured_collection.blocks.tab.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:settings.collection" },
        { "type": "text", "id": "label", "label": "t:sections.featured_collection.blocks.tab.settings.label.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name",
      "blocks": [{ "type": "tab" }]
    }
  ]
}
{% endschema %}
