{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign media_count = product.media.size
-%}

<product-info
  class="section product color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  style="--section-pt: 1.5rem; --section-pb: 4rem;"
>
  <div class="page-width product__grid">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="product__gallery">
      <ul class="product__media-list product__media-list--{{ section.settings.gallery_layout }}" role="list" data-media-list>
        {%- for media in product.media -%}
          <li class="product__media-item" data-media-id="{{ media.id }}">
            <div class="media product__media" style="aspect-ratio: {{ media.aspect_ratio | default: 1 }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    assign priority = 'auto'
                    if forloop.first
                      assign loading = 'eager'
                      assign priority = 'high'
                    endif
                  -%}
                  {%- liquid
                    assign media_alt = media.alt
                    if media_alt == blank or media_alt == product.title
                      assign media_alt = 'seo.image_alt_numbered' | t: title: product.title, number: forloop.index
                    endif
                  -%}
                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      loading: loading,
                      fetchpriority: priority,
                      sizes: '(min-width: 990px) 33vw, 100vw',
                      widths: '400, 600, 800, 1000, 1400, 1800',
                      alt: media_alt
                  }}
                {%- when 'video', 'external_video' -%}
                  {{ media | media_tag: image_size: '1200x', autoplay: false, loop: true, controls: true, muted: true }}
                {%- when 'model' -%}
                  {{ media | media_tag: image_size: '1200x' }}
              {%- endcase -%}
            </div>
          </li>
        {%- else -%}
          <li class="product__media-item">
            <div class="media media--square product__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </li>
        {%- endfor -%}
      </ul>
      {%- if media_count > 1 -%}
        <div class="product__media-counter" aria-hidden="true">
          <span data-media-current>1</span> / {{ media_count }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Info {%- endcomment -%}
    <div class="product__info">
      <div class="product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'vendor' -%}
              <a href="{{ product.vendor | url_for_vendor }}" class="product__vendor eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</a>

            {%- when 'title' -%}
              <h1 class="product__title h2" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <div class="product__price" data-price-container {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant, show_badge: true %}
                {%- if cart.taxes_included -%}
                  <p class="product__tax text-muted">{{ 'products.product.taxes_included' | t }}</p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-picker class="product__variants" data-section-id="{{ section.id }}" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_name = option.name | downcase
                      assign is_color = false
                      if option_name contains 'colo' or option_name contains 'لون' or option_name contains 'ألوان' or option_name contains 'الوان'
                        assign is_color = true
                      endif
                    -%}
                    <fieldset class="option" data-option-index="{{ forloop.index0 }}">
                      <legend class="option__legend">
                        {{ option.name }}: <span class="option__selected" data-selected-value>{{ option.selected_value }}</span>
                      </legend>
                      <div class="option__values{% if is_color %} option__values--swatch{% endif %}">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign input_id = section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0
                            assign swatch_style = ''
                            assign value_swatch = false
                            if is_color
                              if value.swatch.image
                                assign value_swatch = true
                                assign swatch_url = value.swatch.image | image_url: width: 80
                                assign swatch_style = '--swatch: url(' | append: swatch_url | append: ')'
                              elsif value.swatch.color
                                assign value_swatch = true
                                assign swatch_style = '--swatch: ' | append: value.swatch.color
                              endif
                            endif
                          -%}
                          <input
                            type="radio"
                            class="option__input visually-hidden"
                            id="{{ input_id }}"
                            name="{{ option.name | escape }}-{{ section.id }}"
                            value="{{ value | escape }}"
                            {% if value.selected %}
                              checked
                            {% endif %}
                            {% unless value.available %}
                              data-unavailable
                            {% endunless %}
                          >
                          <label
                            for="{{ input_id }}"
                            class="option__label{% if value_swatch %} option__label--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                            {% if value_swatch %}
                              style="{{ swatch_style | escape }}" title="{{ value | escape }}"
                            {% endif %}
                          >
                            {%- if value_swatch -%}
                              <span class="visually-hidden">{{ value }}</span>
                            {%- else -%}
                              {%- if is_color -%}
                                {%- assign dot_color = value | downcase | remove: ' ' | escape -%}
                                <span class="option__dot" style="background-color: {{ dot_color }}" aria-hidden="true"></span>
                              {%- endif -%}
                              {{ value }}
                            {%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  <script type="application/json" data-variants>
                    {{ product.variants | json }}
                  </script>
                </variant-picker>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                <product-form data-section-id="{{ section.id }}">
                  {%- form 'product', product, id: product_form_id, class: 'product__form', novalidate: 'novalidate', data-product-form: '' -%}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                    <div class="product__buy-row">
                      {%- if block.settings.show_quantity -%}
                        <quantity-input class="quantity">
                          <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t }}">
                            {% render 'icon', icon: 'minus' %}
                          </button>
                          <input
                            class="quantity__input"
                            type="number"
                            name="quantity"
                            value="1"
                            min="1"
                            aria-label="{{ 'products.product.quantity.label' | t }}"
                          >
                          <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t }}">
                            {% render 'icon', icon: 'plus' %}
                          </button>
                        </quantity-input>
                      {%- endif -%}
                      <button
                        type="submit"
                        name="add"
                        class="button button--full product__add"
                        data-add-button
                        {% unless current_variant.available %}
                          disabled
                        {% endunless %}
                      >
                        <span data-add-label>
                          {%- if current_variant.available -%}
                            {{ 'products.product.add_to_cart' | t }}
                          {%- else -%}
                            {{ 'products.product.sold_out' | t }}
                          {%- endif -%}
                        </span>
                      </button>
                    </div>
                    {%- if block.settings.show_dynamic_checkout and product.available -%}
                      <div class="product__payment"{% unless product.selected_or_first_available_variant.available %} hidden{% endunless %}>
                        {{ form | payment_button }}
                      </div>
                    {%- endif -%}
                    <p class="form-message form-message--error" data-form-error hidden></p>
                  {%- endform -%}
                </product-form>
                {%- if current_variant.available and current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= block.settings.low_stock_threshold -%}
                  <p class="product__stock">
                    <span class="product__stock-dot"></span>
                    {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'perks' -%}
              <ul class="product__perks" role="list" {{ block.shopify_attributes }}>
                {%- if block.settings.perk_1 != blank -%}
                  <li>{% render 'icon', icon: 'truck' %}<span>{{ block.settings.perk_1 }}</span></li>
                {%- endif -%}
                {%- if block.settings.perk_2 != blank -%}
                  <li>{% render 'icon', icon: 'cash' %}<span>{{ block.settings.perk_2 }}</span></li>
                {%- endif -%}
                {%- if block.settings.perk_3 != blank -%}
                  <li>{% render 'icon', icon: 'return' %}<span>{{ block.settings.perk_3 }}</span></li>
                {%- endif -%}
              </ul>

            {%- when 'description' -%}
              {%- liquid
                capture description_html
                  render 'clean-description', html: product.description
                endcapture
                assign description_text = description_html | strip_html | strip
                assign description_has_media = false
                if description_html contains '<img' or description_html contains '<iframe' or description_html contains '<video'
                  assign description_has_media = true
                endif
              -%}
              {%- if description_text != blank or description_has_media -%}
                <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ 'products.product.description' | t }}{% render 'icon', icon: 'plus' %}</summary>
                  <div class="accordion__content rte">{{ description_html }}</div>
                </details>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading }}{% render 'icon', icon: 'plus' %}</summary>
                <div class="accordion__content rte">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                </div>
              </details>

            {%- when 'text' -%}
              <div class="rte product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                {%- assign share_url = request.origin | append: product.url | url_encode -%}
                <span class="text-muted">{{ 'products.product.share' | t }}</span>
                <a class="icon-button icon-button--bordered" target="_blank" rel="noopener" href="https://wa.me/?text={{ product.title | url_encode }}%20{{ share_url }}" aria-label="WhatsApp">{% render 'icon', icon: 'whatsapp' %}</a>
                <a class="icon-button icon-button--bordered" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}" aria-label="Facebook">{% render 'icon', icon: 'facebook' %}</a>
                <a class="icon-button icon-button--bordered" target="_blank" rel="noopener" href="https://x.com/intent/post?url={{ share_url }}" aria-label="X">{% render 'icon', icon: 'x' %}</a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Mobile sticky add-to-cart bar {%- endcomment -%}
  <div class="product__sticky-bar" data-sticky-bar aria-hidden="true">
    <div class="product__sticky-info">
      <p class="product__sticky-title">{{ product.title }}</p>
      <div data-price-container>{% render 'price', product: product, variant: current_variant %}</div>
    </div>
    <button
      type="submit"
      form="{{ product_form_id }}"
      class="button button--accent"
      tabindex="-1"
      data-add-button
      {% unless current_variant.available %}
        disabled
      {% endunless %}
    >
      <span data-add-label>
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
    </button>
  </div>
</product-info>

{%- assign model_media = product.media | where: 'media_type', 'model' -%}
{%- if model_media.size > 0 -%}
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      if (document.querySelector('.product__media model-viewer') && window.Shopify?.loadFeatures) {
        Shopify.loadFeatures([{ name: 'model-viewer-ui', version: '1.0' }]);
      }
    });
  </script>
{%- endif -%}

{% stylesheet %}
  .product__grid {
    display: grid;
    gap: 1.5rem;
  }

  @media screen and (min-width: 990px) {
    .product__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }

  /* Gallery */
  .product__gallery {
    position: relative;
  }

  .product__media-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 0.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin: 0 -1rem;
    padding: 0 1rem;
    scroll-padding-inline: 1rem;
  }

  .product__media-list::-webkit-scrollbar {
    display: none;
  }

  .product__media-item {
    scroll-snap-align: start;
  }

  .product__media-list .media {
    border-radius: var(--radius);
  }

  .product__media img,
  .product__media video,
  .product__media iframe,
  .product__media model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__media-counter {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-end: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: rgba(var(--color-bg-rgb), 0.85);
    backdrop-filter: blur(8px);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media screen and (min-width: 990px) {
    .product__media-list {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      overflow: visible;
      margin: 0;
      padding: 0;
    }

    .product__media-list--stacked {
      grid-template-columns: 1fr;
    }

    .product__media-list--grid .product__media-item:first-child {
      grid-column: 1 / -1;
    }

    .product__media-counter {
      display: none;
    }
  }

  /* Info */
  .product__info-inner {
    display: grid;
    gap: 1.25rem;
  }

  @media screen and (min-width: 990px) {
    .product__info {
      position: sticky;
      top: 6rem;
    }
  }

  .product__vendor {
    text-decoration: none;
  }

  .product__title {
    margin-block-start: -0.5rem;
  }

  .product__price .price {
    font-size: 1.375rem;
  }

  .product__tax {
    font-size: 0.8125rem;
    margin-block-start: 0.25rem;
  }

  /* Options */
  .product__variants {
    display: grid;
    gap: 1.25rem;
  }

  .option {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.625rem;
  }

  .option__legend {
    padding: 0;
    margin-block-end: 0.625rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .option__selected {
    font-weight: 400;
    color: var(--color-muted);
  }

  .option__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .option__label {
    display: inline-grid;
    place-items: center;
    min-width: 3.25rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .option__label:hover {
    border-color: var(--color-fg);
  }

  .option__input:checked + .option__label {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }

  .option__input:focus-visible + .option__label {
    outline: 2px solid var(--color-fg);
    outline-offset: 2px;
  }

  .option__label.is-unavailable {
    color: var(--color-muted);
    background-image: linear-gradient(to bottom right, transparent calc(50% - 0.5px), var(--color-border) 50%, transparent calc(50% + 0.5px));
  }

  .option__dot {
    display: inline-block;
    width: 0.875rem;
    height: 0.875rem;
    margin-inline-end: 0.375rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    vertical-align: -0.125rem;
  }

  .option__label--swatch {
    min-width: 0;
    width: 2.5rem;
    height: 2.5rem;
    min-height: 0;
    padding: 0;
    border-radius: 50%;
    background: var(--swatch);
    background-size: cover;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.1);
  }

  .option__input:checked + .option__label--swatch {
    background: var(--swatch);
    background-size: cover;
    outline: 2px solid var(--color-fg);
    outline-offset: 3px;
  }

  .option__label--swatch.is-unavailable {
    opacity: 0.45;
  }

  /* Buy */
  .product__form {
    display: grid;
    gap: 0.75rem;
  }

  .product__buy-row {
    display: flex;
    gap: 0.75rem;
  }

  .product__add {
    flex: 1;
    min-height: 3.25rem;
    font-size: 1rem;
  }

  .shopify-payment-button__button {
    min-height: 3.25rem;
    border-radius: var(--radius-button) !important;
    overflow: hidden;
  }

  .product__stock {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #c2410c;
  }

  .product__stock-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    animation: pulse 1.6s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }

  .product__perks {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 1.125rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: 0.9375rem;
  }

  .product__perks li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .product__share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .product__share .icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  /* Sticky bar */
  .product__sticky-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 35;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: rgba(var(--color-bg-rgb), 0.92);
    backdrop-filter: blur(14px);
    border-block-start: 1px solid var(--color-border);
    transform: translateY(110%);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .product__sticky-bar.is-visible {
    transform: none;
  }

  .product__sticky-info {
    flex: 1;
    min-width: 0;
    font-size: 0.875rem;
  }

  .product__sticky-title {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media screen and (min-width: 990px) {
    .product__sticky-bar {
      inset-inline: auto 1.5rem;
      inset-block-end: 1.5rem;
      width: 26rem;
      padding: 0.75rem 0.75rem 0.75rem 1.25rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      box-shadow: 0 20px 50px -20px rgba(0, 0, 0, 0.35);
      transform: translateY(calc(100% + 2rem));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "default": "grid",
      "label": "t:sections.main_product.settings.gallery_layout.label",
      "options": [
        { "value": "grid", "label": "t:sections.main_product.settings.gallery_layout.options__1" },
        { "value": "two-column", "label": "t:sections.main_product.settings.gallery_layout.options__2" },
        { "value": "stacked", "label": "t:sections.main_product.settings.gallery_layout.options__3" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "t:sections.main_product.blocks.vendor.name", "limit": 1 },
    { "type": "title", "name": "t:sections.main_product.blocks.title.name", "limit": 1 },
    { "type": "price", "name": "t:sections.main_product.blocks.price.name", "limit": 1 },
    { "type": "variant_picker", "name": "t:sections.main_product.blocks.variant_picker.name", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "t:sections.main_product.blocks.buy_buttons.name",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "default": true, "label": "t:sections.main_product.blocks.buy_buttons.settings.show_quantity.label" },
        { "type": "checkbox", "id": "show_dynamic_checkout", "default": true, "label": "t:sections.main_product.blocks.buy_buttons.settings.show_dynamic_checkout.label" },
        { "type": "range", "id": "low_stock_threshold", "min": 0, "max": 20, "step": 1, "default": 5, "label": "t:sections.main_product.blocks.buy_buttons.settings.low_stock_threshold.label" }
      ]
    },
    {
      "type": "perks",
      "name": "t:sections.main_product.blocks.perks.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "perk_1", "default": "Delivery in 2–5 days across Egypt", "label": "t:sections.main_product.blocks.perks.settings.perk_1.label" },
        { "type": "text", "id": "perk_2", "default": "Cash on delivery available", "label": "t:sections.main_product.blocks.perks.settings.perk_2.label" },
        { "type": "text", "id": "perk_3", "default": "Easy 14-day returns", "label": "t:sections.main_product.blocks.perks.settings.perk_3.label" }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.main_product.blocks.description.name",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "open", "default": true, "label": "t:sections.main_product.blocks.description.settings.open.label" }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "t:sections.main_product.blocks.collapsible_tab.name",
      "settings": [
