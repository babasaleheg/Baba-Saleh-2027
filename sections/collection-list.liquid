{%- liquid
  assign layout = section.settings.layout
  # Desktop circles wrap into balanced rows of at most 10 (e.g. 14 → 2 rows of 7).
  assign circle_count = section.blocks.size | at_least: 1
  assign circle_rows = circle_count | plus: 9 | divided_by: 10 | floor
  assign circle_cols = circle_count | plus: circle_rows | minus: 1 | divided_by: circle_rows | floor
-%}
<section
  class="section collection-list color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ routes.collections_url }}" class="link-arrow">
            {{- 'general.view_all' | t -}}
            {% render 'icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if layout == 'circles' -%}<circle-slider class="circle-slider">{%- endif -%}
    <ul class="collection-list__grid collection-list__grid--{{ layout }}" role="list" style="--circle-cols: {{ circle_cols }}"{% if layout == 'circles' %} data-circle-track{% endif %}>
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign title = block.settings.title | default: collection.title
          assign url = collection.url | default: '#'
          if title == blank
            assign title = 'sections.collection_list.placeholder' | t
          endif
        -%}
        <li class="collection-tile collection-tile--{{ layout }}" data-reveal style="--reveal-index: {{ forloop.index0 | modulo: 6 }}" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="collection-tile__link">
            <div class="media collection-tile__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '200, 300, 450, 600, 900',
                    alt: title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="collection-tile__title">
              {{- title -}}
              {%- if layout != 'circles' -%}{% render 'icon', icon: 'arrow' %}{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if layout == 'circles' -%}
      <div class="circle-slider__nav" hidden>
        <button type="button" class="circle-slider__btn" data-circle-prev aria-label="{{ 'general.slider.previous' | t }}">{% render 'icon', icon: 'chevron' %}</button>
        <span class="circle-slider__count" data-circle-count aria-live="polite">1/{{ section.blocks.size }}</span>
        <button type="button" class="circle-slider__btn" data-circle-next aria-label="{{ 'general.slider.next' | t }}">{% render 'icon', icon: 'chevron' %}</button>
      </div>
      </circle-slider>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .collection-list__grid {
    margin: 0;
  }

  /* Circles — "shop by sport" swiper: one row, 2 per view on phones, 6 on desktop */
  .collection-list__grid--circles {
    --per-view: 2;
    --circle-gap: 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per-view) - 1) * var(--circle-gap)) / var(--per-view));
    gap: var(--circle-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    /* Room for the hover ring (2px + 3px offset) so the scroller doesn't clip it */
    padding: 0.375rem;
    margin-inline: -0.375rem;
    scroll-padding-inline: 0.375rem;
  }

  @media screen and (min-width: 750px) {
    .collection-list__grid--circles {
      --per-view: 4;
      --circle-gap: 1.25rem;
    }
  }

  @media screen and (min-width: 1100px) {
    .collection-list__grid--circles {
      --per-view: 6;
    }
  }

  circle-slider {
    display: block;
  }

  .circle-slider__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .circle-slider__nav[hidden] {
    display: none;
  }

  .circle-slider__btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .circle-slider__btn:hover {
    background: rgba(var(--color-fg-rgb), 0.07);
    color: var(--color-fg);
  }

  .circle-slider__btn[disabled] {
    opacity: 0.35;
    pointer-events: none;
  }

  .circle-slider__btn .icon {
    width: 1rem;
    height: 1rem;
  }

  [data-circle-prev] .icon {
    transform: scaleX(-1);
  }

  [dir='rtl'] [data-circle-prev] .icon {
    transform: none;
  }

  [dir='rtl'] [data-circle-next] .icon {
    transform: scaleX(-1);
  }

  .collection-list__grid--circles::-webkit-scrollbar {
    display: none;
  }

  .collection-tile--circles {
    scroll-snap-align: start;
    text-align: center;
  }

  .collection-tile--circles .collection-tile__media {
    aspect-ratio: 1;
    border-radius: 50%;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.2s ease;
  }

  /* Same yellow as babasaleh.com */
  .collection-tile--circles .collection-tile__link:hover .collection-tile__media,
  .collection-tile--circles .collection-tile__link:focus-visible .collection-tile__media {
    outline-color: #febd19;
  }

  .collection-tile--circles .collection-tile__title {
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  /* Bento — first tile large */
  .collection-tile--bento .collection-tile__media {
    aspect-ratio: 1;
    height: 100%;
  }

  .collection-tile--bento:first-child {
    grid-column: span 2;
  }

  .collection-tile--bento:first-child .collection-tile__media {
    aspect-ratio: 16 / 10;
  }

  @media screen and (min-width: 750px) {
    /* Fixed row height keeps the bento compact; tiles fill their cell. */
    .collection-list__grid--bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: clamp(10rem, 17vw, 15rem);
      gap: 1rem;
    }

    .collection-tile--bento:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .collection-tile--bento .collection-tile__media,
    .collection-tile--bento:first-child .collection-tile__media {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .collection-tile--circles .collection-tile__media {
    width: 100%;
    max-width: 9rem;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
    { "type": "text", "id": "heading", "default": "Shop by sport", "label": "t:settings.heading" },
    {
      "type": "select",
      "id": "layout",
      "default": "circles",
      "label": "t:settings.layout",
      "options": [
        { "value": "circles", "label": "t:sections.collection_list.settings.layout.options__1" },
        { "value": "cards", "label": "t:sections.collection_list.settings.layout.options__2" },
        { "value": "bento", "label": "t:sections.collection_list.settings.layout.options__3" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "default": true, "label": "t:settings.show_view_all" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:settings.collection" },
        { "type": "image_picker", "id": "image", "label": "t:settings.image_override" },
        { "type": "text", "id": "title", "label": "t:settings.title_override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
