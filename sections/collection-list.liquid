{%- liquid
  assign layout = section.settings.layout
-%}
<section
  class="section collection-list color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.show_view_all -%}
          <a href="{{ routes.collections_url }}" class="link-arrow">
            {{- 'general.view_all' | t -}}
            {% render 'icon', icon: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="collection-list__grid collection-list__grid--{{ layout }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image
          assign title = block.settings.title | default: collection.title
          assign url = collection.url | default: '#'
          if title == blank
            assign title = 'sections.collection_list.placeholder' | t
          endif
        -%}
        <li class="collection-tile collection-tile--{{ layout }}" data-reveal style="--reveal-index: {{ forloop.index0 | modulo: 6 }}" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="collection-tile__link">
            <div class="media collection-tile__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '200, 300, 450, 600, 900',
                    alt: title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="collection-tile__title">
              {{- title -}}
              {%- if layout != 'circles' -%}{% render 'icon', icon: 'arrow' %}{%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .collection-list__grid {
    margin: 0;
  }

  /* Circles — "shop by sport" scroller */
  .collection-list__grid--circles {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 6.5rem;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-block-end: 0.25rem;
  }

  .collection-list__grid--circles::-webkit-scrollbar {
    display: none;
  }

  .collection-tile--circles {
    scroll-snap-align: start;
    text-align: center;
  }

  .collection-tile--circles .collection-tile__media {
    aspect-ratio: 1;
    border-radius: 50%;
    outline: 2px solid transparent;
    outline-offset: 3px;
    transition: outline-color 0.2s ease;
  }

  .collection-tile--circles .collection-tile__link:hover .collection-tile__media {
    outline-color: var(--color-accent);
  }

  .collection-tile--circles .collection-tile__title {
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  @media screen and (min-width: 990px) {
    .collection-list__grid--circles {
      grid-auto-columns: 8.5rem;
      gap: 1.5rem;
    }
  }

  /* Bento — first tile large */
  .collection-tile--bento .collection-tile__media {
    aspect-ratio: 1;
    height: 100%;
  }

  .collection-tile--bento:first-child {
    grid-column: span 2;
  }

  .collection-tile--bento:first-child .collection-tile__media {
    aspect-ratio: 16 / 10;
  }

  @media screen and (min-width: 750px) {
    .collection-list__grid--bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(14rem, auto);
      gap: 1.25rem;
    }

    .collection-tile--bento:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }

    .collection-tile--bento:first-child .collection-tile__media {
      aspect-ratio: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
    { "type": "text", "id": "heading", "default": "Shop by sport", "label": "t:settings.heading" },
    {
      "type": "select",
      "id": "layout",
      "default": "circles",
      "label": "t:settings.layout",
      "options": [
        { "value": "circles", "label": "t:sections.collection_list.settings.layout.options__1" },
        { "value": "cards", "label": "t:sections.collection_list.settings.layout.options__2" },
        { "value": "bento", "label": "t:sections.collection_list.settings.layout.options__3" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "default": true, "label": "t:settings.show_view_all" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:settings.collection" },
        { "type": "image_picker", "id": "image", "label": "t:settings.image_override" },
        { "type": "text", "id": "title", "label": "t:settings.title_override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.name",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
