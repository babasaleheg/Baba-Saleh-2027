<section
  class="section usp-bar color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    <ul class="usp-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="usp-bar__item" {{ block.shopify_attributes }}>
          <span class="usp-bar__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <div>
            <p class="usp-bar__title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}
              <p class="usp-bar__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .usp-bar__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .usp-bar__list {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  .usp-bar__item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .usp-bar__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  .usp-bar__icon .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .usp-bar__title {
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .usp-bar__text {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-block-start: 0.125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.usp_bar.name",
  "max_blocks": 4,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-2", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "t:sections.usp_bar.blocks.usp.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "default": "truck",
          "label": "t:settings.icon",
          "options": [
            { "value": "truck", "label": "t:settings.icon_options.truck" },
            { "value": "cash", "label": "t:settings.icon_options.cash" },
            { "value": "return", "label": "t:settings.icon_options.return" },
            { "value": "shield", "label": "t:settings.icon_options.shield" },
            { "value": "chat", "label": "t:settings.icon_options.chat" },
            { "value": "store", "label": "t:settings.icon_options.store" },
            { "value": "bolt", "label": "t:settings.icon_options.bolt" },
            { "value": "star", "label": "t:settings.icon_options.star" }
          ]
        },
        { "type": "text", "id": "title", "default": "Fast delivery", "label": "t:settings.heading" },
        { "type": "text", "id": "text", "default": "Across all of Egypt", "label": "t:settings.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.usp_bar.name",
      "blocks": [{ "type": "usp" }, { "type": "usp" }, { "type": "usp" }, { "type": "usp" }]
    }
  ]
}
{% endschema %}
