{%- comment -%}
  FAQ accordion built on native <details> (keyboard + screen reader friendly),
  with an optional instant search (<faq-filter> in theme.js) and FAQPage JSON-LD.
{%- endcomment -%}
<section
  class="section faq color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width faq__inner">
    <div class="faq__intro">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2" id="FaqHeading-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--secondary button--small">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <faq-filter class="faq__list">
      {%- if section.settings.show_search and section.blocks.size > 4 -%}
        <div class="field faq__search" hidden>
          <label class="visually-hidden" for="FaqSearch-{{ section.id }}">{{ 'pages.faq.search_label' | t }}</label>
          {%- render 'icon', icon: 'search' -%}
          <input
            id="FaqSearch-{{ section.id }}"
            class="field__input"
            type="search"
            placeholder="{{ 'pages.faq.search_placeholder' | t }}"
            autocomplete="off"
            data-faq-search
          >
        </div>
        <p class="faq__empty text-muted" role="status" data-faq-status data-empty="{{ 'pages.faq.no_results' | t }}"></p>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details class="accordion faq__item" data-faq-item {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>
            <h3 class="faq__question">{{ block.settings.question }}</h3>
            {%- render 'icon', icon: 'plus' -%}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </faq-filter>
  </div>
</section>

{%- if section.settings.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "inLanguage": {{ request.locale.iso_code | json }},
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  faq-filter {
    display: block;
  }

  .faq__inner {
    display: grid;
    gap: 2rem;
  }

  .faq__intro {
    display: grid;
    gap: 0.875rem;
    align-content: start;
    justify-items: start;
  }

  .faq__search {
    margin-block-end: 0.5rem;
  }

  .faq__search .icon {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-muted);
    pointer-events: none;
  }

  .faq__search .field__input {
    padding-inline-start: 2.75rem;
    border-radius: 999px;
  }

  .faq__empty:empty {
    display: none;
  }

  .faq__empty {
    padding-block: 1rem;
  }

  .faq .faq__item {
    padding-inline: 1.25rem;
  }

  .faq .faq__item[open] {
    margin-block: 0.5rem;
    border-block-end-color: transparent;
  }

  .faq .faq__item .accordion__content {
    padding-block-end: 1.25rem;
  }

  .faq__item summary {
    border-radius: var(--radius-small);
  }

  .faq__item summary:hover .faq__question {
    color: var(--color-accent);
  }

  .faq__question {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
    transition: color 0.2s ease;
  }

  /* Smooth open/close where supported */
  @supports (interpolate-size: allow-keywords) {
    .faq__item {
      interpolate-size: allow-keywords;
    }

    .faq__item::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size 0.3s ease, content-visibility 0.3s allow-discrete;
    }

    .faq__item[open]::details-content {
      block-size: auto;
    }
  }

  @media screen and (min-width: 990px) {
    .faq__inner {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 5rem;
    }

    .faq__intro {
      position: sticky;
      top: calc(var(--header-offset, 0px) + 2rem);
    }
  }

  @media print {
    .faq__item::details-content {
      block-size: auto;
      content-visibility: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:pages.faq.name",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
    { "type": "text", "id": "heading", "default": "Frequently asked questions", "label": "t:settings.heading" },
    { "type": "richtext", "id": "text", "label": "t:settings.text" },
    { "type": "text", "id": "button_label", "label": "t:settings.button_label" },
    { "type": "url", "id": "button_link", "label": "t:settings.button_link" },
    { "type": "checkbox", "id": "show_search", "default": true, "label": "t:pages.faq.show_search", "info": "t:pages.faq.show_search_info" },
    { "type": "checkbox", "id": "open_first", "default": false, "label": "t:pages.faq.open_first" },
    { "type": "checkbox", "id": "structured_data", "default": true, "label": "t:pages.faq.structured_data" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:pages.faq.block",
      "settings": [
        { "type": "text", "id": "question", "default": "Do you offer cash on delivery?", "label": "t:pages.faq.question" },
        { "type": "richtext", "id": "answer", "default": "<p>Yes. You can pay in cash when your order arrives, anywhere in Egypt.</p>", "label": "t:pages.faq.answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:pages.faq.name",
      "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
