{%- comment -%}
  Branch / store location cards with directions, call and WhatsApp buttons.
  Each branch with an address is also emitted as a SportingGoodsStore in JSON-LD.
{%- endcomment -%}
{%- liquid
  assign store_whatsapp = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
-%}
<section
  id="branches"
  class="section branches color-{{ section.settings.color_scheme }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.text != blank -%}
      <div class="section-header">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <ul class="branches__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign map_url = block.settings.map_url
          if map_url == blank and block.settings.address != blank
            assign map_query = block.settings.name | append: ' ' | append: block.settings.address | url_encode
            assign map_url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
          endif
          assign phone_digits = block.settings.phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
          assign wa = block.settings.whatsapp | default: store_whatsapp | remove: '+' | remove: ' ' | remove: '-'
          assign heading_id = 'Branch-' | append: block.id
        -%}
        <li class="branch-card" data-spotlight data-reveal style="--reveal-index: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <article aria-labelledby="{{ heading_id }}">
            {%- if block.settings.image != blank -%}
              <div class="media branch-card__media">
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw', widths: '400, 600, 800', alt: block.settings.image.alt
                }}
                <span class="branch-card__index" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              </div>
            {%- else -%}
              <div class="branch-card__media branch-card__media--placeholder" aria-hidden="true">
                <span class="branch-card__placeholder-name">{{ block.settings.name }}</span>
                <span class="branch-card__index">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              </div>
            {%- endif -%}
            <div class="branch-card__body">
              <div class="branch-card__head">
                <span class="branch-card__pin">{% render 'icon', icon: 'pin' %}</span>
                <div>
                  {%- if block.settings.area != blank -%}<p class="branch-card__area">{{ block.settings.area }}</p>{%- endif -%}
                  <h3 class="h3 branch-card__name" id="{{ heading_id }}">{{ block.settings.name }}</h3>
                </div>
              </div>
              <dl class="branch-card__details">
                {%- if block.settings.address != blank -%}
                  <div>
                    <dt>{% render 'icon', icon: 'store' %}<span class="visually-hidden">{{ 'pages.branches.address' | t }}</span></dt>
                    <dd>{{ block.settings.address }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <div>
                    <dt>{% render 'icon', icon: 'clock' %}<span class="visually-hidden">{{ 'pages.branches.hours' | t }}</span></dt>
                    <dd>{{ block.settings.hours | newline_to_br }}</dd>
                  </div>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <div>
                    <dt>{% render 'icon', icon: 'phone' %}<span class="visually-hidden">{{ 'pages.branches.phone' | t }}</span></dt>
                    <dd dir="ltr">{{ block.settings.phone }}</dd>
                  </div>
                {%- endif -%}
              </dl>
              <div class="branch-card__actions">
                {%- if map_url != blank -%}
                  <a class="button button--small" href="{{ map_url }}" target="_blank" rel="noopener">
                    {%- render 'icon', icon: 'pin' -%}
                    {{ 'pages.branches.directions' | t }}
                    <span class="visually-hidden">– {{ block.settings.name }} ({{ 'pages.opens_new_window' | t }})</span>
                  </a>
                {%- endif -%}
                {%- if phone_digits != blank -%}
                  <a class="button button--small button--secondary" href="tel:{{ phone_digits }}">
                    {%- render 'icon', icon: 'phone' -%}
                    {{ 'pages.branches.call' | t }}
                    <span class="visually-hidden">– {{ block.settings.name }}</span>
                  </a>
                {%- endif -%}
                {%- if wa != blank -%}
                  {%- assign wa_text = 'pages.branches.whatsapp_message' | t: branch: block.settings.name | url_encode -%}
                  <a class="button button--small button--secondary branch-card__wa" href="https://wa.me/{{ wa }}?text={{ wa_text }}" target="_blank" rel="noopener">
                    {%- render 'icon', icon: 'whatsapp' -%}
                    {{ 'pages.branches.whatsapp' | t }}
                    <span class="visually-hidden">– {{ block.settings.name }} ({{ 'pages.opens_new_window' | t }})</span>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_map and section.blocks.size > 0 -%}
      <branch-map class="branches__map" data-reveal>
        <div class="branches__map-tabs" role="group" aria-label="{{ 'pages.branches.map_label' | t }}">
          {%- for block in section.blocks -%}
            {%- liquid
              if block.settings.map_query != blank
                assign q = block.settings.map_query | url_encode
              else
                assign q = 'Baba Saleh Sports ' | append: block.settings.address | default: block.settings.name | url_encode
              endif
            -%}
            <button
              type="button"
              class="branches__map-tab"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-map-src="https://maps.google.com/maps?q={{ q }}&z=15&output=embed&hl={{ request.locale.iso_code }}"
              data-map-title="{{ 'pages.branches.map_title' | t: branch: block.settings.name | escape }}"
            >
              {%- render 'icon', icon: 'pin' -%}
              {{ block.settings.name }}
            </button>
          {%- endfor -%}
        </div>
        {%- assign first_branch = section.blocks.first -%}
        {%- liquid
          if first_branch.settings.map_query != blank
            assign q = first_branch.settings.map_query | url_encode
          else
            assign q = 'Baba Saleh Sports ' | append: first_branch.settings.address | url_encode
          endif
        -%}
        <div class="branches__map-frame">
          <iframe
            data-src="https://maps.google.com/maps?q={{ q }}&z=15&output=embed&hl={{ request.locale.iso_code }}"
            title="{{ 'pages.branches.map_title' | t: branch: first_branch.settings.name | escape }}"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      </branch-map>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.structured_data and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    [
      {%- for block in section.blocks -%}
        {
          "@context": "https://schema.org",
          "@type": "SportingGoodsStore",
          "name": {{ shop.name | append: ' – ' | append: block.settings.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }},
          {%- if block.settings.phone != blank -%}"telephone": {{ block.settings.phone | json }},{%- endif -%}
          {%- if block.settings.map_url != blank -%}"hasMap": {{ block.settings.map_url | json }},{%- endif -%}
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ block.settings.address | json }},
            "addressLocality": {{ block.settings.area | default: block.settings.name | json }},
            "addressCountry": "EG"
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
{%- endif -%}

{% stylesheet %}
  #branches {
    scroll-margin-top: 6rem;
  }

  .branches__grid {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  @media screen and (min-width: 600px) {
    .branches__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .branches__grid {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: 1.25rem;
    }
  }

  .branch-card,
  .branch-card > article {
    height: 100%;
  }

  .branch-card > article {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  @media (hover: hover) {
    .branch-card > article:hover {
      border-color: rgba(var(--color-fg-rgb), 0.3);
      box-shadow: 0 18px 40px -26px rgba(var(--color-fg-rgb), 0.5);
      transform: translateY(-2px);
    }
  }

  .branch-card__media {
    aspect-ratio: 16 / 10;
    border-radius: 0;
  }

  .branch-card__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    padding: 1.25rem;
  }

  .branch-card__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .branch-card__pin {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  .branch-card__pin .icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .branch-card__area {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .branch-card__name {
    font-size: 1.25rem;
  }

  .branch-card__details {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.9375rem;
  }

  .branch-card__details > div {
    display: flex;
    gap: 0.625rem;
    align-items: flex-start;
  }

  .branch-card__details dt .icon {
    width: 1.125rem;
    height: 1.125rem;
    margin-block-start: 0.15rem;
    color: var(--color-muted);
  }

  .branch-card__details dd {
    margin: 0;
  }

  [dir='rtl'] .branch-card__details dd[dir='ltr'] {
    text-align: end;
  }

  .branch-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-start: auto;
  }

  .branch-card__actions .icon {
    width: 1.0625rem;
    height: 1.0625rem;
  }

  .branch-card__wa:hover {
    --btn-bg: #25d366;
    --btn-fg: #fff;
    border-color: #25d366;
  }

  /* Photo cards, interactive map */
  .branch-card > article {
    border-radius: 1.5rem;
    border-color: rgba(var(--color-fg-rgb), 0.08);
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.45s ease, border-color 0.45s ease;
  }

  @media (hover: hover) {
    .branch-card > article:hover {
      transform: translateY(-8px);
      border-color: rgba(254, 189, 25, 0.7);
      box-shadow: 0 30px 50px -30px rgba(0, 0, 0, 0.5);
    }
  }

  .branch-card__media {
    position: relative;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
  }

  .branch-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 55%);
  }

  .branch-card__media img {
    transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .branch-card > article:hover .branch-card__media img {
    transform: scale(1.08);
  }

  .branch-card__index {
    position: absolute;
    z-index: 1;
    inset-block-end: 0.75rem;
    inset-inline-start: 1rem;
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 2.75rem;
    line-height: 1;
    color: #febd19;
  }

  .branch-card__tag {
    position: absolute;
    z-index: 1;
    inset-block-start: 0.875rem;
    inset-inline-end: 0.875rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: #fff;
    color: #0a0a0a;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .branch-card__media--placeholder {
    display: grid;
    place-items: center;
    background: #febd19 repeating-linear-gradient(-45deg, transparent 0 22px, rgba(255, 255, 255, 0.18) 22px 44px);
  }

  .branch-card__media--placeholder::after {
    background: none;
  }

  .branch-card__placeholder-name {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: #0a0a0a;
    text-align: center;
    padding-inline: 1rem;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .branch-card > article:hover .branch-card__placeholder-name {
    transform: scale(1.08) rotate(-2deg);
  }

  .branch-card__media--placeholder .branch-card__index {
    color: #0a0a0a;
  }

  .branch-card__pin {
    background: #0a0a0a;
    color: #febd19;
  }

  .branches__map {
    display: grid;
    gap: 1rem;
    margin-block-start: 2.5rem;
  }

  .branches__map-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .branches__map-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    border: 1.5px solid rgba(var(--color-fg-rgb), 0.15);
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }

  .branches__map-tab .icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .branches__map-tab:hover {
    transform: translateY(-2px);
    border-color: #febd19;
  }

  .branches__map-tab[aria-pressed='true'] {
    background: #febd19;
    border-color: #febd19;
    color: #0a0a0a;
  }

  .branches__map-frame {
    position: relative;
    width: 100%;
    height: clamp(20rem, 40vw, 30rem);
    border-radius: 1.5rem;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 0 0 4px #febd19;
  }

  .branches__map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    transition: opacity 0.3s ease;
  }

  .branches__map-frame iframe.is-loading {
    opacity: 0.4;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:pages.branches.name",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:settings.eyebrow" },
    { "type": "text", "id": "heading", "default": "Our branches", "label": "t:settings.heading" },
    { "type": "richtext", "id": "text", "label": "t:settings.text" },
    { "type": "checkbox", "id": "structured_data", "default": true, "label": "t:pages.branches.structured_data" },
    { "type": "checkbox", "id": "show_map", "default": true, "label": "t:pages.branches.show_map" },
    { "type": "color_scheme", "id": "color_scheme", "default": "scheme-1", "label": "t:settings.color_scheme" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48, "label": "t:settings.padding_bottom" }
  ],
  "blocks": [
    {
      "type": "branch",
      "name": "t:pages.branches.block",
      "settings": [
        { "type": "text", "id": "name", "default": "Branch", "label": "t:pages.branches.branch_name" },
        { "type": "text", "id": "area", "label": "t:pages.branches.area" },
        { "type": "textarea", "id": "address", "label": "t:pages.branches.address_label" },
        { "type": "textarea", "id": "hours", "label": "t:pages.branches.hours_label", "info": "t:pages.branches.hours_info" },
        { "type": "text", "id": "phone", "label": "t:pages.branches.phone_label" },
        { "type": "text", "id": "whatsapp", "label": "t:pages.branches.whatsapp_label", "info": "t:pages.branches.whatsapp_info" },
        { "type": "url", "id": "map_url", "label": "t:pages.branches.map_url", "info": "t:pages.branches.map_url_info" },
        { "type": "text", "id": "map_query", "label": "Map search", "info": "What the embedded map looks up, e.g. a mall or landmark name. Leave empty to use Baba Saleh Sports + address." },
        { "type": "image_picker", "id": "image", "label": "t:settings.image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:pages.branches.name",
      "blocks": [{ "type": "branch" }, { "type": "branch" }]
    }
  ]
}
{% endschema %}
