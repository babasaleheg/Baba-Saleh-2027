<!doctype html>
{%- liquid
  assign locale_lang = request.locale.iso_code | split: '-' | first
  assign text_direction = 'ltr'
  if 'ar,he,fa,ur' contains locale_lang
    assign text_direction = 'rtl'
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {% render 'fonts' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="color-scheme-1">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
