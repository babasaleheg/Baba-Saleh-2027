<!doctype html>
{%- liquid
  assign rtl_locales = 'ar,he,fa,ur'
  assign locale_lang = request.locale.iso_code | split: '-' | first
  assign text_direction = 'ltr'
  if rtl_locales contains locale_lang
    assign text_direction = 'rtl'
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    {%- comment -%}
      Forward pages that people and Google still land on to the right page: Shopify's bare
      "Contact information" policy page, and old WooCommerce links (on the 404 page).
    {%- endcomment -%}
    {%- liquid
      assign forward_url = ''
      if request.path contains '/policies/contact-information'
        assign forward_url = routes.root_url | append: '/pages/contact-us' | replace: '//', '/'
      endif
    -%}
    {%- if forward_url != '' -%}
      <meta http-equiv="refresh" content="0; url={{ forward_url }}">
      <link rel="canonical" href="{{ request.origin }}{{ forward_url }}">
      <script>window.location.replace({{ forward_url | json }});</script>
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url }}">
    {%- endif -%}
    {%- if template.name == '404' -%}
      {%- comment -%}
        Old WooCommerce links that Google and customers still use (/product/<slug>, /brand/<name>,
        /color/..., /size/..., /product-category/<cat>/page/2, .../feed): send them to the Shopify
        page. Runs in the browser because Liquid only sees "/404" here.
      {%- endcomment -%}
      <script>
        (function () {
          var locales = {{ shop.published_locales | map: 'iso_code' | json }};
          var parts = location.pathname.split('/').filter(function (x) { return x && x !== 'feed'; });
          var prefix = parts.length && locales.indexOf(parts[0]) > -1 ? '/' + parts.shift() : '';
          var seg = parts[0], val = parts[1], to = '';
          if (seg === 'product' && val) to = '/products/' + val;
          else if (seg === 'products' && val) to = '/search?q=' + encodeURIComponent(val.replace(/[-_]+/g, ' '));
          else if (seg === 'brand' && parts.length > 1) to = '/collections/vendors?q=' + encodeURIComponent(parts[parts.length - 1]);
          else if (['color', 'size', 'product-tag', 'shop'].indexOf(seg) > -1) to = '/collections/all';
          else if (seg === 'product-category') {
            var cat = '';
            for (var i = 1; i < parts.length && parts[i] !== 'page'; i++) cat = parts[i];
            if (cat) to = '/collections/' + cat;
          }
          if (to) location.replace(prefix + to);
        })();
      </script>
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="icon" type="image/png" sizes="192x192" href="{{ settings.favicon | image_url: width: 192, height: 192 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'structured-data' %}
    {% render 'tracking', part: 'head' %}
    {% render 'fonts' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'buy-now-button.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      // Extras that aren't needed for the first view (e.g. hover photos on cards) wait for this.
      window.addEventListener('load', () => document.documentElement.classList.add('is-loaded'), { once: true });
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          added: {{ 'products.product.added' | t | json }}
        },
        cartType: {{ settings.cart_type | json }},
        currency: {{ cart.currency.iso_code | json }},
        direction: {{ text_direction | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="color-scheme-1 template-{{ template.name | handle }}{% if settings.animations_enabled %} has-animations{% endif %}">
    {% render 'tracking', part: 'body' %}
    <a class="skip-link button" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {%- if request.page_type == 'index' -%}
        <h1 class="visually-hidden">{{ 'seo.home_h1' | t }}</h1>
      {%- endif -%}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.whatsapp_number != blank -%}
      {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
      <a
        class="whatsapp-fab"
        href="https://wa.me/{{ wa_number }}"
        target="_blank"
        rel="noopener"
        aria-label="{{ 'general.whatsapp' | t }}"
      >
        {% render 'icon', icon: 'whatsapp' %}
      </a>
    {%- endif -%}

    <div class="toast" role="status" aria-live="polite" hidden></div>
  </body>
</html>
