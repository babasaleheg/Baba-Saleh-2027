{%- comment -%}
  White Friday decorations: circles, rings, sparkles, a burst badge, dots, zigzag and price tags.
  Purely decorative (aria-hidden). Usage: {% render 'wf-shapes', pct: 29, is_ar: is_ar %}
  Brand colours only: white, yellow #FEBD19, ink #0A0A0A.
{%- endcomment -%}
<div class="wf-shapes" aria-hidden="true">
  <span class="wf-shape wf-shape--sun"></span>
  <span class="wf-shape wf-shape--ring"></span>
  <span class="wf-shape wf-shape--ring2"></span>
  <span class="wf-shape wf-shape--dots"></span>
  <svg class="wf-shape wf-shape--zigzag" viewBox="0 0 120 24" fill="none"><path d="M2 20 L14 4 L26 20 L38 4 L50 20 L62 4 L74 20 L86 4 L98 20 L110 4 L118 14" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <svg class="wf-shape wf-shape--spark wf-shape--spark1" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z"/></svg>
  <svg class="wf-shape wf-shape--spark wf-shape--spark2" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z"/></svg>
  <svg class="wf-shape wf-shape--spark wf-shape--spark3" viewBox="0 0 24 24"><path fill="currentColor" d="M12 0c.6 6.2 5.8 11.4 12 12-6.2.6-11.4 5.8-12 12-.6-6.2-5.8-11.4-12-12C6.2 11.4 11.4 6.2 12 0z"/></svg>
  <svg class="wf-shape wf-shape--tag" viewBox="0 0 64 64" fill="none"><path d="M6 30V8a2 2 0 0 1 2-2h22l28 28-24 24L6 30z" fill="#fff" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><circle cx="20" cy="20" r="5" fill="currentColor"/><path d="M28 40l12-12M30 30h.01M38 38h.01" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
  <svg class="wf-shape wf-shape--bag" viewBox="0 0 64 64" fill="none"><path d="M12 22h40l-3 34H15L12 22z" fill="#FEBD19" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M24 26v-8a8 8 0 0 1 16 0v8" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
  <span class="wf-shape wf-shape--burst"><b dir="ltr">-<i data-nov-max>{{ pct | default: 29 }}</i>%</b><small>{% if is_ar %}لحد{% else %}up to{% endif %}</small></span>
</div>

{% stylesheet %}
  .wf-shapes { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; color: #0a0a0a; }
  .wf-shape { position: absolute; display: block; }
  .wf-shape--sun { width: clamp(220px, 34vw, 460px); aspect-ratio: 1; border-radius: 50%; background: #febd19;
    inset-block-start: -12%; inset-inline-end: -8%; animation: wf-float 9s ease-in-out infinite; }
  .wf-shape--ring { width: clamp(260px, 40vw, 540px); aspect-ratio: 1; border-radius: 50%;
    border: 3px dashed #0a0a0a; inset-block-start: -18%; inset-inline-end: -12%; opacity: 0.35; animation: wf-spin 40s linear infinite; }
  .wf-shape--ring2 { width: clamp(90px, 12vw, 160px); aspect-ratio: 1; border-radius: 50%; border: 14px solid #febd19;
    inset-block-end: -40px; inset-inline-start: 6%; animation: wf-float 7s ease-in-out infinite reverse; }
  .wf-shape--dots { width: 160px; height: 110px; inset-block-start: 12%; inset-inline-start: 2%; opacity: 0.25;
    background-image: radial-gradient(#0a0a0a 2.5px, transparent 2.6px); background-size: 18px 18px; }
  .wf-shape--zigzag { width: 110px; inset-block-end: 14%; inset-inline-end: 36%; color: #febd19; }
  .wf-shape--spark { color: #febd19; animation: wf-twinkle 2.4s ease-in-out infinite; }
  .wf-shape--spark1 { width: 34px; inset-block-start: 14%; inset-inline-end: 42%; }
  .wf-shape--spark2 { width: 22px; inset-block-end: 22%; inset-inline-start: 38%; color: #0a0a0a; animation-delay: 0.8s; }
  .wf-shape--spark3 { width: 26px; inset-block-start: 58%; inset-inline-end: 8%; animation-delay: 1.5s; }
  .wf-shape--tag { width: 64px; inset-block-end: 10%; inset-inline-end: 22%; transform: rotate(-14deg); animation: wf-bob 4s ease-in-out infinite; }
  .wf-shape--bag { width: 58px; inset-block-start: 10%; inset-inline-start: 44%; transform: rotate(10deg); animation: wf-bob 5s ease-in-out infinite 0.6s; }
  .wf-shape--burst { inset-block-start: 22%; inset-inline-end: 7%; width: clamp(96px, 12vw, 150px); aspect-ratio: 1; display: grid; place-content: center;
    text-align: center; color: #febd19; background: #0a0a0a; line-height: 1;
    clip-path: polygon(50% 0, 61% 12%, 77% 6%, 80% 22%, 96% 25%, 90% 40%, 100% 52%, 88% 63%, 94% 79%, 78% 81%, 73% 97%, 58% 89%, 45% 100%, 37% 86%, 20% 93%, 19% 76%, 3% 71%, 11% 57%, 0 44%, 13% 35%, 8% 19%, 25% 18%, 30% 3%, 43% 11%);
    animation: wf-spin-slow 18s linear infinite; }
  .wf-shape--burst b { font-size: clamp(24px, 3.4vw, 40px); font-weight: 900; }
  .wf-shape--burst b i { font-style: normal; }
  .wf-shape--burst small { margin-top: 4px; color: #fff; font-size: 12px; font-weight: 700; }
  @keyframes wf-float { 50% { transform: translateY(-14px) scale(1.03); } }
  @keyframes wf-spin { to { transform: rotate(360deg); } }
  @keyframes wf-spin-slow { from { transform: rotate(-8deg); } 50% { transform: rotate(8deg) scale(1.05); } to { transform: rotate(-8deg); } }
  @keyframes wf-twinkle { 0%, 100% { transform: scale(0.6) rotate(0deg); opacity: 0.5; } 50% { transform: scale(1.1) rotate(45deg); opacity: 1; } }
  @keyframes wf-bob { 50% { transform: translateY(-10px) rotate(-6deg); } }
  @media screen and (max-width: 749px) {
    .wf-shape--burst, .wf-shape--tag, .wf-shape--dots, .wf-shape--zigzag { display: none; }
    .wf-shape--bag { inset-inline-start: auto; inset-inline-end: 30%; inset-block-start: 4%; width: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .wf-shape { animation: none !important; } }
{% endstylesheet %}
