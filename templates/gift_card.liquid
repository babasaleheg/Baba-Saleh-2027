{%- layout none -%}
{%- assign initial_value = gift_card.initial_value | money_without_trailing_zeros -%}
{%- assign expiry = gift_card.expires_on | date: format: 'date' -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value }} — {{ shop.name }}</title>
    {% render 'fonts' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="color-{{ settings.cart_color_scheme }}">
    <main class="section page-width gift-card">
      <p class="h3">{{ shop.name }}</p>
      <h1 class="h1">{{ 'gift_cards.issued.title' | t: value: initial_value }}</h1>
      {%- if gift_card.expired -%}
        <p class="badge badge--muted">{{ 'gift_cards.issued.expired' | t: expiry: expiry }}</p>
      {%- endif -%}
      <div class="gift-card__code">
        <input class="field__input" type="text" value="{{ gift_card.code }}" readonly aria-label="{{ 'gift_cards.issued.code' | t }}" onclick="this.select()">
      </div>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <p class="text-muted">{{ 'gift_cards.issued.balance' | t }}: {{ gift_card.balance | money }}</p>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a>
      {%- endif -%}
      <div class="gift-card__actions">
        <a href="{{ shop.url }}" class="button" target="_blank" rel="noopener">{{ 'gift_cards.issued.shop_link' | t }}</a>
        <button type="button" class="button button--secondary" onclick="window.print();">{{ 'gift_cards.issued.print' | t }}</button>
      </div>
    </main>
    <script>
      window.addEventListener('load', () => {
        const el = document.getElementById('QrCode');
        if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
      });
    </script>
    <style>
      .gift-card { display: grid; gap: 1.25rem; justify-items: center; text-align: center; max-width: 36rem; }
      .gift-card__actions { display: flex; gap: .5rem; flex-wrap: wrap; justify-content: center; }
    </style>
  </body>
</html>
