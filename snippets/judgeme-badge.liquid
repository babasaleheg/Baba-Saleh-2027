{%- comment -%}
  Judge.me star rating for a product. Judge.me hides it when the product has no reviews.
  - product: product object
  - badge_template: 'product' on the product page, 'manual-installation' on cards (default)
{%- endcomment -%}
<div
  class="jdgm-widget jdgm-preview-badge"
  data-id="{{ product.id }}"
  data-template="{{ badge_template | default: 'manual-installation' }}"
  data-auto-install="false"
>
  {{- product.metafields.judgeme.badge -}}
</div>

{% stylesheet %}
  /* Gold stars everywhere Judge.me draws them (badges, reviews, form). */
  .jdgm-star,
  .jdgm-star.jdgm--on,
  .jdgm-star.jdgm--half,
  .jdgm-star.jdgm--off {
    color: #f5b301 !important;
  }

  .jdgm-preview-badge {
    font-size: 0.875rem;
  }

  /* Judge.me review widget (app block at the end of the product page): same side margins and
     width as the rest of the page, and a short form (no review title, no photo upload). */
  .shopify-app-block .jdgm-review-widget,
  .jdgm-widget.jdgm-review-widget {
    box-sizing: border-box;
    width: 100%;
    max-width: var(--page-width);
    margin-inline: auto !important;
    padding-inline: 1rem !important;
    padding-block: 2rem 3rem;
  }

  @media screen and (min-width: 750px) {
    .shopify-app-block .jdgm-review-widget,
    .jdgm-widget.jdgm-review-widget {
      padding-inline: 2rem !important;
    }
  }

  .jdgm-rev-widg__title {
    text-align: start !important;
    font-family: var(--font-heading-family);
  }

  .jdgm-form__fieldset:has([name='review_title']),
  .jdgm-form__fieldset:has(.jdgm-picture-fieldset),
  .jdgm-picture-fieldset {
    display: none !important;
  }
{% endstylesheet %}
