{%- comment -%}
  Free-shipping progress bar. Shared by the cart drawer and cart page.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 100
  if threshold > 0 and remaining > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif
-%}
{%- if settings.free_shipping_threshold > 0 -%}
  <div class="shipping-progress" style="--progress: {{ progress }}%">
    <p class="shipping-progress__text">
      {%- if remaining > 0 -%}
        {%- assign remaining_money = remaining | money -%}
        {{ 'cart.free_shipping.remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {% render 'icon', icon: 'check' %}{{ 'cart.free_shipping.unlocked' | t }}
      {%- endif -%}
    </p>
    <div class="shipping-progress__bar"><span></span></div>
  </div>
{%- endif -%}

{% stylesheet %}
  .shipping-progress {
    display: grid;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    font-size: 0.875rem;
  }

  .shipping-progress__text {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .shipping-progress__text .icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-success);
  }

  .shipping-progress__bar {
    height: 6px;
    border-radius: 999px;
    background: rgba(var(--color-fg-rgb), 0.1);
    overflow: hidden;
  }

  .shipping-progress__bar span {
    display: block;
    width: var(--progress);
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-fg), var(--color-accent));
    transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
{% endstylesheet %}
