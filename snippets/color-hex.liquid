{%- comment -%}
  Outputs a CSS color for a color option value, e.g. "Navy blue" -> #1f2a44.
  Usage: {%- capture hex -%}{% render 'color-hex', name: value %}{%- endcapture -%}
  1. Exact names (English and Arabic) get a tuned shade.
  2. New names are matched by the color word inside them, so "Royal Blue",
     "Light Green" or "أزرق ملكي" still get a sensible shade.
  3. Anything else falls back to the name itself, so plain CSS colors still work.
  Add a new exact color: put its name (lowercase, no spaces) in a `when` line below.
{%- endcomment -%}
{%- liquid
  assign key = name | append: '' | downcase | remove: ' ' | remove: '-' | remove: '_' | strip
  case key
    when 'black', 'أسود', 'اسود'
      echo '#111111'
    when 'white', 'أبيض', 'ابيض'
      echo '#ffffff'
    when 'offwhite', 'cream', 'ivory', 'أوفوايت', 'اوفوايت', 'كريمي'
      echo '#f3efe4'
    when 'red', 'أحمر', 'احمر'
      echo '#d32f2f'
    when 'burgundy', 'maroon', 'wine', 'نبيتي', 'عنابي'
      echo '#7b1e2e'
    when 'fuchsia', 'فوشيا', 'فوشي'
      echo '#d81b7a'
    when 'pink', 'وردي', 'بينك', 'روز'
      echo '#f2a2bd'
    when 'lightpink', 'babypink', 'وردىفاتح', 'ورديفاتح'
      echo '#f8cad8'
    when 'rosegold', 'روزجولد'
      echo '#d9a08b'
    when 'orange', 'برتقالي', 'برتقالى', 'اورنج'
      echo '#f57c00'
    when 'yellow', 'أصفر', 'اصفر'
      echo '#fdd835'
    when 'softyellow', 'lightyellow', 'اصفرفاتح'
      echo '#f6e58d'
    when 'gold', 'golden', 'ذهبي', 'دهبي'
      echo '#c9a227'
    when 'beige', 'بيج'
      echo '#d9c3a0'
    when 'brown', 'بني', 'بنى'
      echo '#6d4c41'
    when 'green', 'أخضر', 'اخضر'
      echo '#2e7d32'
    when 'olivegreen', 'olive', 'زيتي', 'زيتى'
      echo '#6b7a3a'
    when 'mintgreen', 'mint', 'منت', 'مينت'
      echo '#a8e6cf'
    when 'blue', 'أزرق', 'ازرق'
      echo '#1e63c9'
    when 'babyblue', 'lightblue', 'skyblue', 'لبني', 'لبنى'
      echo '#9fcfef'
    when 'navyblue', 'navy', 'darkblue', 'كحلي', 'كحلى'
      echo '#1f2a44'
    when 'turquoise', 'تركواز', 'فيروزي'
      echo '#1fb5ad'
    when 'purple', 'violet', 'بنفسجي', 'موف'
      echo '#7b4da6'
    when 'gray', 'grey', 'رمادي', 'رمادى', 'رصاصي'
      echo '#8e8e8e'
    when 'darkgray', 'darkgrey', 'charcoal', 'رماديغامق', 'فحمي'
      echo '#4a4a4a'
    when 'lightgray', 'lightgrey', 'رماديفاتح'
      echo '#cfcfcf'
    when 'silver', 'فضي', 'فضى'
      echo '#c0c0c0'
    else
      if key contains 'multi' or key contains 'rainbow' or key contains 'colorful' or key contains 'ملون' or key contains 'الوان' or key contains 'ألوان'
        echo 'conic-gradient(#d32f2f, #fdd835, #2e7d32, #1e63c9, #7b4da6, #d32f2f)'
      elsif key contains 'navy' or key contains 'كحلي' or key contains 'كحلى'
        echo '#1f2a44'
      elsif key contains 'baby' or key contains 'sky' or key contains 'لبني' or key contains 'لبنى'
        echo '#9fcfef'
      elsif key contains 'turquoise' or key contains 'teal' or key contains 'aqua' or key contains 'تركواز' or key contains 'فيروزي'
        echo '#1fb5ad'
      elsif key contains 'blue' or key contains 'ازرق' or key contains 'أزرق'
        echo '#1e63c9'
      elsif key contains 'mint' or key contains 'منت'
        echo '#a8e6cf'
      elsif key contains 'olive' or key contains 'khaki' or key contains 'army' or key contains 'زيتي'
        echo '#6b7a3a'
      elsif key contains 'green' or key contains 'اخضر' or key contains 'أخضر'
        echo '#2e7d32'
      elsif key contains 'burgundy' or key contains 'maroon' or key contains 'wine' or key contains 'نبيتي' or key contains 'عنابي'
        echo '#7b1e2e'
      elsif key contains 'fuchsia' or key contains 'magenta' or key contains 'فوشي'
        echo '#d81b7a'
      elsif key contains 'rose' and key contains 'gold'
        echo '#d9a08b'
      elsif key contains 'pink' or key contains 'وردي' or key contains 'بينك'
        echo '#f2a2bd'
      elsif key contains 'red' or key contains 'احمر' or key contains 'أحمر'
        echo '#d32f2f'
      elsif key contains 'orange' or key contains 'برتقال' or key contains 'اورنج'
        echo '#f57c00'
      elsif key contains 'gold' or key contains 'ذهبي' or key contains 'دهبي'
        echo '#c9a227'
      elsif key contains 'yellow' or key contains 'اصفر' or key contains 'أصفر'
        echo '#fdd835'
      elsif key contains 'beige' or key contains 'cream' or key contains 'nude' or key contains 'sand' or key contains 'بيج'
        echo '#d9c3a0'
      elsif key contains 'brown' or key contains 'coffee' or key contains 'camel' or key contains 'بني'
        echo '#6d4c41'
      elsif key contains 'purple' or key contains 'violet' or key contains 'lilac' or key contains 'lavender' or key contains 'بنفسج' or key contains 'موف'
        echo '#7b4da6'
      elsif key contains 'silver' or key contains 'فضي'
        echo '#c0c0c0'
      elsif key contains 'charcoal' or key contains 'darkgr' or key contains 'غامق'
        echo '#4a4a4a'
      elsif key contains 'gray' or key contains 'grey' or key contains 'رمادي' or key contains 'رصاصي'
        echo '#8e8e8e'
      elsif key contains 'white' or key contains 'ابيض' or key contains 'أبيض'
        echo '#ffffff'
      elsif key contains 'black' or key contains 'اسود' or key contains 'أسود'
        echo '#111111'
      else
        echo key
      endif
  endcase
-%}
