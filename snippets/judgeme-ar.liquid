{%- comment -%}
  Judge.me reviews in Arabic on Arabic pages (Arabic pages never show English text, CLAUDE.md rule 5).
  Judge.me's own texts are English only (one store language), so on /ar pages they are swapped for
  Arabic the moment Judge.me sets its settings (before its deferred loader runs), and the widget is
  laid out right to left.
{%- endcomment -%}
{%- if request.locale.iso_code contains 'ar' -%}
  <script>
    (function () {
      var ar = {
        locale: 'ar',
        badge_no_review_text: 'لا توجد تقييمات',
        badge_n_reviews_text: '{{ "{{" }} n }} تقييم',
        widget_title: 'تقييمات العملاء',
        widget_open_form_text: 'اكتب تقييمك',
        widget_close_form_text: 'إلغاء',
        widget_refresh_page_text: 'تحديث الصفحة',
        widget_summary_text: 'بناءً على {{ "{{" }} number_of_reviews }} تقييم',
        widget_no_review_text: 'كن أول من يكتب تقييمًا',
        widget_name_field_text: 'الاسم',
        widget_verified_name_field_text: 'الاسم الموثق (يظهر للجميع)',
        widget_name_placeholder_text: 'الاسم',
        widget_required_field_error_text: 'الخانة دي مطلوبة.',
        widget_email_field_text: 'البريد الإلكتروني',
        widget_verified_email_field_text: 'البريد الموثق (خاص، لا يمكن تعديله)',
        widget_email_placeholder_text: 'بريدك الإلكتروني',
        widget_email_field_error_text: 'من فضلك اكتب بريد إلكتروني صحيح.',
        widget_rating_field_text: 'التقييم',
        widget_review_title_field_text: 'عنوان التقييم',
        widget_review_title_placeholder_text: 'اكتب عنوانًا لتقييمك',
        widget_review_body_field_text: 'تقييمك',
        widget_review_body_placeholder_text: 'ابدأ الكتابة هنا...',
        widget_pictures_field_text: 'صورة/فيديو (اختياري)',
        widget_submit_review_text: 'إرسال التقييم',
        widget_submit_verified_review_text: 'إرسال التقييم الموثق',
        widget_show_default_reviews_out_of_total_text: 'عرض {{ "{{" }} n_reviews_shown }} من {{ "{{" }} n_reviews }} تقييم.',
        widget_show_all_link_text: 'عرض الكل',
        widget_show_less_link_text: 'عرض أقل',
        widget_author_said_text: '{{ "{{" }} reviewer_name }} قال:',
        widget_days_text: 'منذ {{ "{{" }} n }} يوم',
        widget_weeks_text: 'منذ {{ "{{" }} n }} أسبوع',
        widget_months_text: 'منذ {{ "{{" }} n }} شهر',
        widget_years_text: 'منذ {{ "{{" }} n }} سنة',
        widget_yesterday_text: 'أمس',
        widget_today_text: 'اليوم',
        widget_replied_text: 'رد {{ "{{" }} shop_name }}:',
        widget_read_more_text: 'اقرأ المزيد',
        widget_rating_filter_see_all_text: 'كل التقييمات',
        widget_sorting_most_recent_text: 'الأحدث',
        widget_sorting_highest_rating_text: 'الأعلى تقييمًا',
        widget_sorting_lowest_rating_text: 'الأقل تقييمًا',
        widget_sorting_with_pictures_text: 'بالصور فقط',
        widget_sorting_most_helpful_text: 'الأكثر إفادة',
