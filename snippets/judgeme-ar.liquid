        widget_sort_by_text: 'ترتيب حسب',
        review_widget_clear_filters_text: 'مسح الفلاتر',
        review_widget_expand_more_text: 'المزيد',
        review_widget_voting_label: 'مفيد؟',
        review_widget_shop_reply_label: 'رد {{ "{{" }} shop_name }}:',
        verified_badge_text: 'موثق',
        widget_verified_text: 'موثق',
        widget_verified_by_shop_text: 'موثق من المتجر',
        widget_review_pending_text: 'قيد المراجعة',
        widget_load_more_text: 'عرض المزيد',
        widget_show_more_text: 'عرض المزيد',
        widget_no_items_text: 'لا توجد نتائج',
        widget_reviews_subtab_text: 'التقييمات',
        widget_questions_subtab_text: 'الأسئلة',
        widget_open_question_form_text: 'اسأل سؤال',
