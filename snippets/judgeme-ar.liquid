        widget_next_button_text: 'التالي',
        widget_review_submitted_text: 'تم إرسال التقييم!',
        review_content_screen_title_text: 'إيه تقييمك للمنتج؟',
        review_content_introduction_text: 'يسعدنا تشاركنا تجربتك.',
        one_star_review_guidance_text: 'ضعيف',
        five_star_review_guidance_text: 'ممتاز',
        customer_information_screen_title_text: 'عنك',
        customer_information_introduction_text: 'عرفنا عنك أكتر.',
        review_submitted_screen_title_text: 'شكرًا على تقييمك!',
        review_submitted_screen_thank_you_text: 'بنراجعه وهيظهر في المتجر قريب.',
        reviewer_media_screen_title_picture_or_video_text: 'شارك صورة أو فيديو',
        reviewer_media_introduction_picture_or_video_text: 'ارفع صورة أو فيديو مع تقييمك.',
        advanced_settings_next_step_button_text: 'التالي',
        advanced_settings_close_review_button_text: 'إغلاق',
        write_review_flow_required_text: 'مطلوب',
        write_review_flow_privacy_message_text: 'بنحترم خصوصيتك.',
        write_review_flow_required_field_error_text: 'الخانة دي مطلوبة',
        write_review_flow_invalid_email_error_text: 'من فضلك اكتب بريد إلكتروني صحيح',
        write_review_flow_media_upload_text: '<b>اضغط للرفع</b> أو اسحب الملف هنا',
        branding_text: 'Judge.me'
      };
      // Judge.me sets window.jdgmSettings later in the page: patch it the moment it is set
      var current = window.jdgmSettings;
      var patch = function (v) { if (v && typeof v === 'object') for (var k in ar) v[k] = ar[k]; return v; };
      try {
        Object.defineProperty(window, 'jdgmSettings', {
          configurable: true,
          get: function () { return current; },
          set: function (v) { current = patch(v); }
        });
      } catch (e) {}
      patch(current);
    })();
  </script>
  <style>
    .jdgm-widget, .jdgm-widget *, .jdgm-rev-widg, .jdgm-rev-widg * { direction: rtl; }
    .jdgm-widget, .jdgm-rev-widg { text-align: right; }
    .jdgm-widget input[type='email'], .jdgm-widget .jdgm-rev__timestamp { direction: ltr; unicode-bidi: isolate; }
  </style>
{%- endif -%}
