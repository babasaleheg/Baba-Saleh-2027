{%- comment -%}
  Cart line items, used by the cart drawer and the cart page.
  - context: 'drawer' or 'page'
{%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
      <a href="{{ item.url }}" class="media media--square cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title, sizes: '120px', widths: '120, 200, 300' }}
        {%- endif -%}
      </a>
      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant text-muted">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__variant text-muted">{{ property.first }}: {{ property.last }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-item__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
        {%- endfor -%}

        <div class="cart-item__row">
          <quantity-input class="quantity quantity--small" data-line="{{ forloop.index }}">
            <button type="button" class="quantity__button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t }}">
              {% render 'icon', icon: 'minus' %}
            </button>
            <input
              class="quantity__input"
              type="number"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              aria-label="{{ 'products.product.quantity.label' | t }}"
              data-cart-quantity
              data-line="{{ forloop.index }}"
            >
            <button type="button" class="quantity__button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t }}">
              {% render 'icon', icon: 'plus' %}
            </button>
          </quantity-input>

          <div class="cart-item__price">
            {%- if item.original_line_price != item.final_line_price -%}
              <s class="text-muted">{{ item.original_line_price | money }}</s>
            {%- endif -%}
            <span>{{ item.final_line_price | money }}</span>
          </div>
        </div>

        <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}">
          {{- 'cart.remove' | t -}}
        </button>
      </div>
    </li>
  {%- endfor -%}
</ul>

{% stylesheet %}
  .cart-items {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }

  .cart-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    transition: opacity 0.2s ease;
  }

  .cart-item.is-loading {
    opacity: 0.45;
    pointer-events: none;
  }

  .cart-item__media {
    border-radius: var(--radius-small);
  }

  .cart-item__details {
    display: grid;
    gap: 0.25rem;
    align-content: start;
    font-size: 0.9375rem;
  }

  .cart-item__title {
    font-weight: 600;
    text-decoration: none;
    line-height: 1.3;
  }

  .cart-item__variant,
  .cart-item__discount {
    font-size: 0.8125rem;
  }

  .cart-item__discount {
    color: var(--color-sale);
  }

  .cart-item__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  .cart-item__price {
    display: grid;
    justify-items: end;
    font-weight: 700;
  }

  .cart-item__price s {
    font-weight: 400;
    font-size: 0.8125rem;
  }

  .cart-item__remove {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .cart-page .cart-item {
      grid-template-columns: 8rem 1fr;
      gap: 1.5rem;
    }
  }
{% endstylesheet %}
