{%- comment -%}
  Search field with predictive results.
  - id_prefix: unique prefix for IDs
  - placeholder: optional placeholder override
{%- endcomment -%}
{%- liquid
  assign search_placeholder = placeholder
  if search_placeholder == blank
    assign search_placeholder = 'general.search.placeholder' | t
  endif
-%}
<predictive-search class="search-form" data-results-id="{{ id_prefix }}PredictiveResults">
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form__form">
    <label for="{{ id_prefix }}SearchInput" class="visually-hidden">{{ 'general.search.search' | t }}</label>
    {% render 'icon', icon: 'search' %}
    <input
      id="{{ id_prefix }}SearchInput"
      class="search-form__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ search_placeholder | escape }}"
      autocomplete="off"
      role="combobox"
      aria-expanded="false"
      aria-controls="{{ id_prefix }}PredictiveResults"
      aria-haspopup="listbox"
    >
    <input type="hidden" name="options[prefix]" value="last">
  </form>
  <div id="{{ id_prefix }}PredictiveResults" class="search-form__results" hidden></div>
</predictive-search>

{% stylesheet %}
  .search-form {
    position: relative;
    display: block;
  }

  .search-form__form {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-form__form > .icon {
    position: absolute;
    inset-inline-start: 1rem;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-muted);
    pointer-events: none;
  }

  .search-form__input {
    width: 100%;
    height: 2.75rem;
    padding-inline: 2.75rem 1rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--color-surface);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .search-form__input:focus {
    outline: none;
    border-color: var(--color-fg);
    background: var(--color-bg);
  }

  .search-form__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-form__results {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 0.5rem);
    z-index: 40;
    max-height: min(70vh, 34rem);
    overflow-y: auto;
    padding: 0.5rem;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-fg);
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.3);
  }

  @media screen and (min-width: 990px) {
    .search-form__results {
      inset-inline: auto 0;
      width: min(34rem, 90vw);
    }
  }
{% endstylesheet %}
