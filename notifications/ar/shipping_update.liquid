{% comment %} Baba Saleh notification template. Generated by notifications/build.py - edit the generator, not this file. {% endcomment %}
<!DOCTYPE html>
<html lang="ar" dir="rtl" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>تحديث بخصوص شحن الطلب {{ name }}</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
  table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; border-collapse:collapse; }
  img { border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }
  body { margin:0 !important; padding:0 !important; width:100% !important; background:#F4F4F5; font-family:'Cairo', Tahoma, Arial, sans-serif; }
  a { color:#1E3AFF; }
  .t-link:hover { text-decoration:underline !important; }
  @media only screen and (max-width:620px) {
    .container { width:100% !important; }
    .px { padding-left:16px !important; padding-right:16px !important; }
    .h1 { font-size:22px !important; }
    .btn, .btn td, .btn a { display:block !important; width:100% !important; box-sizing:border-box; text-align:center !important; }
    .thumb { width:48px !important; height:48px !important; }
  }
  /* Dark mode: explicit dark surfaces; header band is already ink and the logo sits on a white chip. */
  @media (prefers-color-scheme: dark) {
    body, .wrap { background:#000000 !important; }
    .card { background:#18181B !important; }
    .surface { background:#27272A !important; }
    .t-ink { color:#F4F4F5 !important; }
    .t-muted { color:#A1A1AA !important; }
    .t-link { color:#9DABFF !important; }
    .line { border-color:#3F3F46 !important; }
  }
  [data-ogsc] .t-ink { color:#F4F4F5 !important; }
  [data-ogsc] .t-muted { color:#A1A1AA !important; }
  [data-ogsc] .t-link { color:#9DABFF !important; }
  [data-ogsb] .card { background:#18181B !important; }
  [data-ogsb] .surface { background:#27272A !important; }
</style>
</head>
<body class="wrap" dir="rtl" style="margin:0;padding:0;background:#F4F4F5;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#F4F4F5;opacity:0;">يوجد تحديث على شحنتك.&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
<table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F4F4F5" style="background:#F4F4F5;">
<tr><td align="center" style="padding:24px 10px;">
<table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;" dir="rtl">

<!-- Header -->
<tr><td height="6" bgcolor="#FEBD19" style="background:#FEBD19;height:6px;line-height:6px;font-size:0;border-radius:14px 14px 0 0;">&nbsp;</td></tr>
<tr><td bgcolor="#0A0A0A" align="center" style="background:#0A0A0A;padding:22px 24px;">
  <a href="https://babasaleh.com" target="_blank" style="text-decoration:none;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td bgcolor="#FFFFFF" style="background:#FFFFFF;border-radius:10px;padding:10px 16px;">
        <img src="https://babasaleh.myshopify.com/cdn/shop/files/baba-saleh-logo-desktop.png" width="180" alt="Baba Saleh" style="display:block;width:180px;max-width:100%;height:auto;border:0;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0A0A0A;">
      </td>
    </tr></table>
  </a>
</td></tr>

<!-- Body -->
<tr><td class="card px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:32px 32px 12px;font-family:'Cairo', Tahoma, Arial, sans-serif;" align="right">
<h1 class="h1 t-ink" style="margin:0 0 12px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:26px;line-height:1.3;font-weight:700;color:#0A0A0A;">تحديث الشحن</h1>
<p class="t-ink" style="margin:0 0 14px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:15px;line-height:1.65;color:#0A0A0A;">{% if customer.first_name != blank %}أهلاً {{ customer.first_name }}،{% else %}أهلاً بك،{% endif %}</p>
<p class="t-ink" style="margin:0 0 14px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:15px;line-height:1.65;color:#0A0A0A;">تم تحديث بيانات شحن طلبك رقم <strong dir="ltr">{{ name }}</strong>. إليك آخر المعلومات.</p>
{% if fulfillment.tracking_numbers.size > 0 %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0;">
  <tr><td class="surface" bgcolor="#F4F4F5" style="background:#F4F4F5;border-radius:10px;padding:16px 18px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:14px;line-height:1.6;color:#0A0A0A;" align="right">
{% if fulfillment.tracking_company != blank %}<div><span class="t-muted" style="color:#6B7280;">شركة الشحن:</span> <strong>{{ fulfillment.tracking_company }}</strong></div>{% endif %}
{% for bs_tn in fulfillment.tracking_numbers %}{% assign bs_tu = fulfillment.tracking_urls[forloop.index0] %}<div style="margin-top:6px;"><span class="t-muted" style="color:#6B7280;">رقم التتبع:</span> <strong dir="ltr">{{ bs_tn }}</strong>{% if bs_tu != blank %} &nbsp;<a class="t-link" href="{{ bs_tu }}" style="color:#1E3AFF;font-weight:700;">تتبّع الشحنة</a>{% endif %}</div>{% endfor %}
  </td></tr>
</table>
{% endif %}
{% if order_status_url != blank %}<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn" style="margin:22px 0 8px;">
  <tr><td align="center" bgcolor="#1E3AFF" style="border-radius:10px;background:#1E3AFF;">
    <a href="{{ order_status_url }}" target="_blank" style="display:inline-block;padding:14px 30px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:16px;font-weight:700;line-height:1.2;color:#FFFFFF;text-decoration:none;border-radius:10px;">تابع حالة طلبك</a>
  </td></tr>
</table>
{% endif %}
<h2 class="t-ink" style="margin:28px 0 8px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:17px;line-height:1.4;font-weight:700;color:#0A0A0A;">المنتجات في هذه الشحنة</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 4px;border-top:1px solid #E4E4E7;" class="line">
{% for bs_row in fulfillment.fulfillment_line_items %}{% assign line = bs_row.line_item %}{% assign bs_qty = bs_row.quantity %}{% if line.product.title != blank %}{% assign bs_title = line.product.title %}{% else %}{% assign bs_title = line.title %}{% endif %}
<tr>
  <td class="line" width="68" valign="top" style="padding:12px 0;border-bottom:1px solid #E4E4E7;width:68px;">{% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" alt="{{ bs_title | escape }}" width="56" height="56" class="thumb" style="display:block;width:56px;height:56px;border-radius:8px;border:1px solid #E4E4E7;object-fit:cover;">{% endif %}</td>
  <td class="line" valign="top" align="right" style="padding:12px 10px;border-bottom:1px solid #E4E4E7;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:14px;line-height:1.5;">
    <div class="t-ink" style="font-weight:600;color:#0A0A0A;">{{ bs_title }}</div>
    {% if line.variant.title != blank and line.variant.title != 'Default Title' %}<div class="t-muted" style="font-size:13px;color:#6B7280;">{{ line.variant.title }}</div>{% endif %}
    <div class="t-muted" style="font-size:13px;color:#6B7280;">الكمية: <span dir="ltr">{{ bs_qty }}</span></div>
  </td>
  
</tr>
{% endfor %}
</table>

</td></tr>

<tr><td class="card px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:0 32px 28px;" align="right">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td class="surface" bgcolor="#F4F4F5" style="background:#F4F4F5;border-radius:12px;padding:18px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:14px;line-height:1.6;color:#0A0A0A;" align="right">
      <strong class="t-ink" style="color:#0A0A0A;">تحتاج مساعدة؟</strong><br>
      <span class="t-muted" style="color:#6B7280;">فريقنا يرد بشكل أسرع على واتساب.</span><br>
      <a class="t-link" href="https://wa.me/201028305495" style="color:#1E3AFF;font-weight:700;text-decoration:none;">واتساب <span dir="ltr">+20 102 830 5495</span></a>
      &nbsp;·&nbsp; <a class="t-link" href="mailto:support@babasaleh.com" style="color:#1E3AFF;text-decoration:none;">support@babasaleh.com</a>
    </td></tr>
  </table>
</td></tr>

<!-- Footer -->
<tr><td bgcolor="#0A0A0A" align="center" style="background:#0A0A0A;padding:22px 24px;border-radius:0 0 14px 14px;font-family:'Cairo', Tahoma, Arial, sans-serif;font-size:13px;line-height:1.7;color:#D4D4D8;">
  <div style="color:#FEBD19;font-weight:700;">الدفع عند الاستلام &nbsp;·&nbsp; شحن لجميع المحافظات &nbsp;·&nbsp; استرجاع خلال 14 يوماً</div>
  <div style="margin-top:8px;">
    <a href="https://babasaleh.com" style="color:#FFFFFF;text-decoration:none;">babasaleh.com</a> &nbsp;·&nbsp;
    <a href="https://wa.me/201028305495" style="color:#FFFFFF;text-decoration:none;">واتساب <span dir="ltr">+20 102 830 5495</span></a> &nbsp;·&nbsp;
    <a href="mailto:support@babasaleh.com" style="color:#FFFFFF;text-decoration:none;">support@babasaleh.com</a>
  </div>
  <div style="margin-top:8px;color:#A1A1AA;">&copy; {{ 'now' | date: '%Y' }} بابا صالح للأدوات الرياضية - مصر</div>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
