{% comment %} Baba Saleh notification template. Generated by notifications/build.py - edit the generator, not this file. {% endcomment %}
<!DOCTYPE html>
<html lang="en" dir="ltr" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Order {{ name }} updated</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
  table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; border-collapse:collapse; }
  img { border:0; outline:none; text-decoration:none; -ms-interpolation-mode:bicubic; }
  body { margin:0 !important; padding:0 !important; width:100% !important; background:#F4F4F5; font-family:'Poppins', Arial, Helvetica, sans-serif; }
  a { color:#0A0A0A; }
  .t-link:hover { text-decoration:underline !important; }
  @media only screen and (max-width:620px) {
    .container { width:100% !important; }
    .px { padding-left:16px !important; padding-right:16px !important; }
    .h1 { font-size:22px !important; }
    .btn, .btn td, .btn a { display:block !important; width:100% !important; box-sizing:border-box; text-align:center !important; }
    .thumb { width:48px !important; height:48px !important; }
  }
  /* Dark mode: explicit dark surfaces; header band is already ink and the logo sits on a white chip. */
  @media (prefers-color-scheme: dark) {
    body, .wrap { background:#000000 !important; }
    .card { background:#18181B !important; }
    .surface { background:#27272A !important; }
    .t-ink { color:#F4F4F5 !important; }
    .t-muted { color:#A1A1AA !important; }
    .t-link { color:#FEBD19 !important; }
    .line { border-color:#3F3F46 !important; }
  }
  [data-ogsc] .t-ink { color:#F4F4F5 !important; }
  [data-ogsc] .t-muted { color:#A1A1AA !important; }
  [data-ogsc] .t-link { color:#FEBD19 !important; }
  [data-ogsb] .card { background:#18181B !important; }
  [data-ogsb] .surface { background:#27272A !important; }
</style>
</head>
<body class="wrap" dir="ltr" style="margin:0;padding:0;background:#F4F4F5;">
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#F4F4F5;opacity:0;">Your order has been updated. Review the latest details.&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
<table role="presentation" class="wrap" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#F4F4F5" style="background:#F4F4F5;">
<tr><td align="center" style="padding:24px 10px;">
<table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;" dir="ltr">

<!-- Header -->
<tr><td height="6" bgcolor="#FEBD19" style="background:#FEBD19;height:6px;line-height:6px;font-size:0;border-radius:14px 14px 0 0;">&nbsp;</td></tr>
<tr><td bgcolor="#0A0A0A" align="center" style="background:#0A0A0A;padding:22px 24px;">
  <a href="https://babasaleh.com" target="_blank" style="text-decoration:none;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td bgcolor="#FFFFFF" style="background:#FFFFFF;border-radius:10px;padding:10px 16px;">
        <img src="https://babasaleh.myshopify.com/cdn/shop/files/baba-saleh-logo-desktop.png" width="180" alt="Baba Saleh" style="display:block;width:180px;max-width:100%;height:auto;border:0;font-family:Arial,sans-serif;font-size:20px;font-weight:700;color:#0A0A0A;">
      </td>
    </tr></table>
  </a>
</td></tr>


<!-- Body (en) -->
<tr><td class="card px" bgcolor="#FFFFFF" dir="ltr" lang="en" style="background:#FFFFFF;padding:32px 32px 12px;font-family:'Poppins', Arial, Helvetica, sans-serif;" align="left">
<h1 class="h1 t-ink" style="margin:0 0 12px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:26px;line-height:1.3;font-weight:700;color:#0A0A0A;">Your order has been updated</h1>
<p class="t-ink" style="margin:0 0 14px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#0A0A0A;">{% if customer.first_name != blank %}Hi {{ customer.first_name }},{% else %}Hi there,{% endif %}</p>
<p class="t-ink" style="margin:0 0 14px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:15px;line-height:1.65;color:#0A0A0A;">We've made changes to order <strong dir="ltr">{{ name }}</strong>. Here is the updated summary.</p>
{% if order_status_url != blank %}<table role="presentation" cellpadding="0" cellspacing="0" border="0" class="btn" style="margin:22px 0 8px;">
  <tr><td align="center" bgcolor="#FEBD19" style="border-radius:10px;background:#FEBD19;">
    <a href="{{ order_status_url }}" target="_blank" style="display:inline-block;padding:14px 30px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:16px;font-weight:700;line-height:1.2;color:#0A0A0A;text-decoration:none;border-radius:10px;">View order status</a>
  </td></tr>
</table>
{% endif %}
<h2 class="t-ink" style="margin:28px 0 8px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:17px;line-height:1.4;font-weight:700;color:#0A0A0A;">Updated order</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:6px 0 4px;border-top:1px solid #E4E4E7;" class="line">
{% for line in subtotal_line_items %}{% assign bs_qty = line.quantity %}{% if line.product.title != blank %}{% assign bs_title = line.product.title %}{% else %}{% assign bs_title = line.title %}{% endif %}
<tr>
  <td class="line" width="68" valign="top" style="padding:12px 0;border-bottom:1px solid #E4E4E7;width:68px;">{% if line.image %}<img src="{{ line | img_url: 'compact_cropped' }}" alt="{{ bs_title | escape }}" width="56" height="56" class="thumb" style="display:block;width:56px;height:56px;border-radius:8px;border:1px solid #E4E4E7;object-fit:cover;">{% endif %}</td>
  <td class="line" valign="top" align="left" style="padding:12px 10px;border-bottom:1px solid #E4E4E7;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;line-height:1.5;">
    <div class="t-ink" style="font-weight:600;color:#0A0A0A;">{{ bs_title }}</div>
    {% if line.variant.title != blank and line.variant.title != 'Default Title' %}<div class="t-muted" style="font-size:13px;color:#6B7280;">{{ line.variant.title }}</div>{% endif %}
    <div class="t-muted" style="font-size:13px;color:#6B7280;">Qty: <span dir="ltr">{{ bs_qty }}</span></div>
  </td>
  <td class="line t-ink" valign="top" align="right" style="padding:12px 0;border-bottom:1px solid #E4E4E7;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;font-weight:600;color:#0A0A0A;white-space:nowrap;"><span dir="ltr">{{ line.final_line_price | money }}</span>{% if line.original_line_price > line.final_line_price %}<br><s class="t-muted" style="font-weight:400;color:#6B7280;"><span dir="ltr">{{ line.original_line_price | money }}</span></s>{% endif %}</td>
</tr>
{% endfor %}
</table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0;">
<tr><td class="t-muted" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#6B7280;" align="left">Subtotal</td><td class="t-ink" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#0A0A0A;font-weight:600;" align="right"><span dir="ltr">{{ subtotal_price | money }}</span></td></tr>
{% if total_discounts > 0 %}<tr><td class="t-muted" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#6B7280;" align="left">Discount</td><td class="t-ink" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#0A0A0A;font-weight:600;" align="right"><span dir="ltr" style="color:#E5242B;">-{{ total_discounts | money }}</span></td></tr>{% endif %}
{% if shipping_price != nil %}<tr><td class="t-muted" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#6B7280;" align="left">Shipping</td><td class="t-ink" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#0A0A0A;font-weight:600;" align="right">{% if shipping_price == 0 %}Free{% else %}<span dir="ltr">{{ shipping_price | money }}</span>{% endif %}</td></tr>{% endif %}
{% if tax_price > 0 %}<tr><td class="t-muted" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#6B7280;" align="left">Taxes</td><td class="t-ink" style="padding:5px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;color:#0A0A0A;font-weight:600;" align="right"><span dir="ltr">{{ tax_price | money }}</span></td></tr>{% endif %}
</table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:2px solid #0A0A0A;" class="line"><tr><td class="t-ink" style="padding:10px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:16px;font-weight:700;color:#0A0A0A;" align="left">Total</td><td class="t-ink" style="padding:10px 0;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:18px;font-weight:700;color:#0A0A0A;" align="right"><span dir="ltr">{{ total_price | money }}</span></td></tr></table>
{% assign bs_due = total_outstanding | default: total_price %}{% unless financial_status == 'paid' or financial_status == 'refunded' or financial_status == 'voided' or bs_due == 0 %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0;">
  <tr><td class="surface" bgcolor="#FFF6DD" style="background:#FFF6DD;border-left:4px solid #FEBD19;border-radius:10px;padding:16px 18px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;line-height:1.6;color:#0A0A0A;" align="left">
<strong>Cash on delivery</strong><br>Please have <span dir="ltr">{{ bs_due | money }}</span> ready when our courier arrives. Card payments may be available on delivery too.
  </td></tr>
</table>
{% endunless %}
{% if shipping_address %}
<h2 class="t-ink" style="margin:28px 0 8px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:17px;line-height:1.4;font-weight:700;color:#0A0A0A;">Delivery address</h2>
<p class="t-ink" style="margin:0 0 14px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#0A0A0A;">{{ shipping_address.name }}<br>{{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}<br>{{ shipping_address.address2 }}{% endif %}<br>{{ shipping_address.city }}{% if shipping_address.province != blank %}, {{ shipping_address.province }}{% endif %}<br>{{ shipping_address.country }}{% if shipping_address.phone != blank %}<br><span dir="ltr">{{ shipping_address.phone }}</span>{% endif %}</p>
{% endif %}
{% if shipping_method.title != blank %}<p class="t-ink" style="margin:0 0 14px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;line-height:1.65;color:#0A0A0A;"><span class="t-muted" style="color:#6B7280;">Shipping method:</span> {{ shipping_method.title }}</p>
{% endif %}

</td></tr>

<tr><td class="card px" bgcolor="#FFFFFF" style="background:#FFFFFF;padding:0 32px 28px;" align="left">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td class="surface" bgcolor="#F4F4F5" style="background:#F4F4F5;border-radius:12px;padding:18px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:14px;line-height:1.6;color:#0A0A0A;" align="left">
      <strong class="t-ink" style="color:#0A0A0A;">Need help?</strong><br>
      <span class="t-muted" style="color:#6B7280;">Our team replies fastest on WhatsApp.</span><br>
      <a class="t-link" href="https://wa.me/201028305495" style="color:#0A0A0A;font-weight:700;text-decoration:none;">WhatsApp <span dir="ltr">+20 102 830 5495</span></a>
      &nbsp;·&nbsp; <a class="t-link" href="mailto:support@babasaleh.com" style="color:#0A0A0A;text-decoration:none;">support@babasaleh.com</a>
    </td></tr>
  </table>
</td></tr>

<!-- Footer -->
<tr><td bgcolor="#0A0A0A" align="center" style="background:#0A0A0A;padding:22px 24px;border-radius:0 0 14px 14px;font-family:'Poppins', Arial, Helvetica, sans-serif;font-size:13px;line-height:1.7;color:#D4D4D8;">
  <div style="color:#FEBD19;font-weight:700;">Cash on delivery &nbsp;·&nbsp; Shipping to all governorates &nbsp;·&nbsp; 7-day returns</div>
  <div style="margin-top:8px;">
    <a href="https://babasaleh.com" style="color:#FFFFFF;text-decoration:none;">babasaleh.com</a> &nbsp;·&nbsp;
    <a href="https://wa.me/201028305495" style="color:#FFFFFF;text-decoration:none;">WhatsApp <span dir="ltr">+20 102 830 5495</span></a> &nbsp;·&nbsp;
    <a href="mailto:support@babasaleh.com" style="color:#FFFFFF;text-decoration:none;">support@babasaleh.com</a>
  </div>
  <div style="margin-top:8px;color:#A1A1AA;">&copy; {{ 'now' | date: '%Y' }} Baba Saleh Sports Egypt</div>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
